phase_emulation_image() {
    local version=$1 image=$2
    require_exec python3 "${PY_BIN}"
    if [[ ! -f "${image}" ]]; then
        echo "missing ${version} reference image: ${image}" >&2
        echo "Set BKB_V1_IMAGE or keep the tracked firmware-custom/build image." >&2
        echo "This phase does not rebuild from a stock dump and does not skip." >&2
        return 1
    fi
    if ! "${PY_BIN}" -c 'import unicorn' >/dev/null 2>&1; then
        echo "missing required Python module: unicorn (tested with 2.1.4)" >&2
        echo "Install it yourself, for example: ${PY_BIN} -m pip install --user 'unicorn==2.1.4'" >&2
        echo "Default QA does not install Python packages." >&2
        return 1
    fi
    PYTHONDONTWRITEBYTECODE=1 "${PY_BIN}" "${ROOT}/firmware-custom/smoke_assert_${version}.py" "${image}"
}

phase_emulation_v1() {
    phase_emulation_image v1 "${BKB_V1_IMAGE:-${ROOT}/firmware-custom/build/bkb-stm32f407-flash-clockmod-v1.bin}"
}

phase_emulation_active_slots() {
    phase_emulation_image active_slots "${BKB_V1_IMAGE:-${ROOT}/firmware-custom/build/bkb-stm32f407-flash-clockmod-v1.bin}"
}

phase_source_baseline() {
    require_exec python3 "${PY_BIN}"
    require_exec git git
    require_exec patch patch
    require_exec sha256sum sha256sum
    PYTHONDONTWRITEBYTECODE=1 "${PY_BIN}" "${ROOT}/scripts/test-sgminer-source.py"
}

phase_native() {
    bash "${ROOT}/sgminer-build/test-native.sh" helpers
}

phase_native_tsan() {
    bash "${ROOT}/sgminer-build/test-native.sh" tsan
}

phase_driver() {
    bash "${ROOT}/sgminer-build/test-native.sh" driver
}

phase_firmware_build() {
    local out=${BKB_FIRMWARE_OUT:-${ROOT}/sgminer-build/build/firmware-rebuild}
    local version built ref ref_sha built_sha
    local -a args
    for version in v1; do
        args=(--out-dir "${out}" "${version}")
        if [[ -n "${BKB_STOCK_DUMP:-}" ]]; then
            args=(--dump "${BKB_STOCK_DUMP}" "${args[@]}")
        fi
        bash "${ROOT}/firmware-custom/build.sh" "${args[@]}" || return
        built="${out}/bkb-stm32f407-flash-clockmod-${version}.bin"
        ref="${ROOT}/firmware-custom/build/bkb-stm32f407-flash-clockmod-${version}.bin"
        ref_sha=$(sha256sum "${ref}" | awk '{print $1}')
        built_sha=$(sha256sum "${built}" | awk '{print $1}')
        echo "reference ${version} sha256 ${ref_sha}"
        echo "rebuilt   ${version} sha256 ${built_sha}"
        if [[ "${ref_sha}" != "${built_sha}" ]]; then
            echo "rebuilt ${version} image does not match the tracked reference" >&2
            echo "The reference was built with gcc-arm-none-eabi 13.2. A different compiler can change stub bytes." >&2
            echo "The tracked image was not replaced." >&2
            return 1
        fi
        echo "rebuilt ${version} matches the tracked reference and was not copied over it"
    done
}

phase_arm_compat() {
    bash "${ROOT}/sgminer-build/build-arm.sh"
}

run_phase() {
    local name=$1
    local fn=$2
    echo "=== ${name} ==="
    set +e
    (
        set -euo pipefail
        "${fn}"
    )
    local status=$?
    set -e
    if [[ "${status}" -eq 0 ]]; then
        RESULTS+=("${name} PASS")
        echo "--- ${name} PASS ---"
    else
        RESULTS+=("${name} FAIL")
        FAILED=1
        echo "--- ${name} FAIL (exit ${status}) ---" >&2
    fi
}

requested=()
if [[ $# -eq 0 ]]; then
    requested=("${DEFAULT_PHASES[@]}")
else
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                usage
                exit 0
                ;;
            --describe)
                describe
                exit 0
                ;;
            host)
                requested+=("${ALL_HOST_PHASES[@]}")
                shift
                ;;
            all)
                requested+=( "${ALL_HOST_PHASES[@]}" driver )
                shift
                ;;
            contract-php|contract-node|contract-python|emulation-v1|emulation-active-slots|network|source-baseline|native|native-tsan|driver|firmware-build|arm-compat|firmware-container)
                requested+=("$1")
                shift
                ;;
            *)
                echo "unknown phase: $1" >&2
                usage >&2
                exit 2
                ;;
        esac
    done
fi

RESULTS=()
FAILED=0
for phase in "${requested[@]}"; do
    case "${phase}" in
        contract-php) run_phase contract-php phase_contract_php ;;
        contract-node) run_phase contract-node phase_contract_node ;;
        contract-python) run_phase contract-python phase_contract_python ;;
        emulation-v1) run_phase emulation-v1 phase_emulation_v1 ;;
        emulation-active-slots) run_phase emulation-active-slots phase_emulation_active_slots ;;
        network) run_phase network phase_network ;;
        source-baseline) run_phase source-baseline phase_source_baseline ;;
        native) run_phase native phase_native ;;
        native-tsan) run_phase native-tsan phase_native_tsan ;;
        driver) run_phase driver phase_driver ;;
        firmware-build) run_phase firmware-build phase_firmware_build ;;
        arm-compat) run_phase arm-compat phase_arm_compat ;;
        firmware-container) run_phase firmware-container phase_firmware_container ;;
        *)
            echo "unhandled phase: ${phase}" >&2
            exit 2
            ;;
    esac
done

echo
echo "QA root: ${ROOT}"
echo "Requested:"
for row in "${RESULTS[@]}"; do
    echo "  ${row}"
done

not_run=()
for opt in "${OPTIONAL_PHASES[@]}"; do
    seen=0
    for phase in "${requested[@]}"; do
        if [[ "${phase}" == "${opt}" ]]; then
            seen=1
        fi
    done
    if [[ "${seen}" -eq 0 ]]; then
        not_run+=("${opt}")
    fi
done
if [[ "${#not_run[@]}" -gt 0 ]]; then
    echo "Not run (optional, not a pass): ${not_run[*]}"
fi
if [[ "${FAILED}" -ne 0 ]]; then
    echo "RESULT: FAIL"
    exit 1
fi
echo "RESULT: PASS"
exit 0
