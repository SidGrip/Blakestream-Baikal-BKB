#!/usr/bin/env bash
# Portable V2.2 QA entry point. Run it from any working directory.
# Default phases need no miner, network, root, stock dump, or sgminer source.
# Optional phases fail closed when their prerequisites are missing. A phase
# that was not requested is reported as not run; that is not a pass.
set -euo pipefail

if ! command -v dirname >/dev/null 2>&1; then
    echo "missing required dirname (coreutils)" >&2
    exit 1
fi
SCRIPT_DIR=$(dirname -- "${BASH_SOURCE[0]}")
ROOT=$(cd "${SCRIPT_DIR}/.." && pwd)
PHP_BIN=${BKB_PHP:-php}
NODE_BIN=${BKB_NODE:-node}
PY_BIN=${BKB_PYTHON:-python3}

DEFAULT_PHASES=(contract-php contract-node contract-python emulation-v1 emulation-active-slots)
OPTIONAL_PHASES=(network source-baseline native native-tsan driver firmware-build arm-compat firmware-container)
ALL_HOST_PHASES=("${DEFAULT_PHASES[@]}" native native-tsan driver)

usage() {
    cat <<EOF
Usage: scripts/qa [phase ...]
       scripts/qa --help
       scripts/qa --describe

Default phases (no arguments):
  contract-php       PHP accepted-work, dev-activity, startup-count, and identity tests
  contract-node      Node activity counters, polling, and unified Boards tests
  contract-python    Python clock, recorder, report, wire-contract, and QA entry tests
  emulation-v1       Unicorn smoke of the tracked v1 image (no stock dump)
  emulation-active-slots  V1 inactive-slot selection and strict active failures

Optional phases, each a failure if its tools or inputs are missing:
  network           Offline network transaction, filesystem and real D-Bus type tests
  source-baseline    Offline source bundle restoration and all 36 patches (git, patch)
  native             ASan/UBSan diagnostic helper tests (patched sgminer tree, gcc)
  native-tsan        ThreadSanitizer concurrency test (x86_64 setarch -R)
  driver             Host harness that includes driver-baikalu.c
  firmware-build     Rebuild v1 from a verified stock dump (ARM bare-metal gcc)
  arm-compat         Docker ARMv7 configure/build plus the native tests
  firmware-container Offline firmware/HTTP/sudo/screen integration (prepared Docker image)

  host               default phases plus native and native-tsan
  all                host plus driver

Paths come from this script's location, not the current directory. Overrides:
  BKB_PHP BKB_NODE BKB_PYTHON
  BKB_SGMINER_SRC BKB_QA_OUT
  BKB_V1_IMAGE
  BKB_STOCK_DUMP BKB_FIRMWARE_OUT
  BKB_ARM_IMAGE BKB_ARM_OUTPUT
  BKB_FIRMWARE_QA_IMAGE

Default QA does not ssh, flash, apt-install, docker-pull, or clone.
EOF
}

describe() {
    cat <<EOF
Repository: ${ROOT}
Default phases are required. An optional phase not run is not a pass:
  ${OPTIONAL_PHASES[*]}
Invoke them by name. A missing prerequisite of a requested phase exits non-zero.
EOF
}

require_exec() {
    local label=$1
    local bin=$2
    if [[ "${bin}" == */* ]]; then
        if [[ ! -x "${bin}" ]]; then
            echo "missing required ${label}: ${bin}" >&2
            return 1
        fi
        return 0
    fi
    if ! command -v "${bin}" >/dev/null 2>&1; then
        echo "missing required ${label}: ${bin}" >&2
        return 1
    fi
}

