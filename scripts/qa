    require_exec python3 "${PY_BIN}"
    "${PY_BIN}" -c 'import dbus' || { echo 'network QA requires python3-dbus in BKB_PYTHON' >&2; return 1; }
    export PYTHONDONTWRITEBYTECODE=1
    "${PY_BIN}" "${ROOT}/scripts/test-network-bindings.py"
    "${PY_BIN}" "${ROOT}/scripts/test-network-runtime.py"
