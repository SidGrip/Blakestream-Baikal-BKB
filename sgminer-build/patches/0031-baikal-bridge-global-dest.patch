+static bool baikal_setoption_global_locked(struct cgpu_info *baikal,
+                                           uint16_t clk, uint8_t mode,
+                                           uint8_t temp, uint8_t fanspeed)
+{
+    int amount;
+    int sent_clock_code;
+    int i;
+    struct baikal_info *info = baikal->device_data;
+    baikal_msg msg = {0, };
+
+    if (info->miner_count != 3) {
+        applog(LOG_WARNING,
+               "BK-B bridge-global SET_OPTION requires exactly 3 boards; detected=%d",
+               info->miner_count);
+        return false;
+    }
+
+    msg.miner_id = 0;
+    msg.cmd = BAIKAL_SET_OPTION;
+    baikal_log_raw_clock_experiment_build();
+    sent_clock_code = baikal_experiment_clock_code(
+        baikal_clock_command_code(clk), clk);
+    msg.data[0] = sent_clock_code;
+    msg.data[1] = mode;
+    msg.data[2] = temp;
+    msg.data[3] = fanspeed;
+    msg.dest = 1;
+    msg.len = 4;
+
+    applog(LOG_NOTICE,
+           "BK-B bridge-global SET_OPTION request requested=%dMHz pll_index=%d mode=%u cutoff=%u fan=%u dest=1 targets=12",
+           (int)clk, sent_clock_code, mode, temp, fanspeed);
+
+    amount = baikal_sendmsg(baikal, &msg);
+    if (amount < 0)
+        return false;
+
+    amount = baikal_readmsg(baikal, &msg, 7);
+    if (amount < 0)
+        return false;
+
+    if (msg.miner_id != 0 || msg.cmd != BAIKAL_SET_OPTION ||
+            msg.param != 1 || msg.dest != 1) {
+        applog(LOG_WARNING,
+               "BK-B bridge-global SET_OPTION ACK mismatch reply_miner_id=%d cmd=0x%02x param=0x%02x status=0x%02x",
+               msg.miner_id, msg.cmd, msg.param, msg.dest);
+        return false;
+    }
+
+    baikal_log_protocol_msg("SET_OPTION bridge-global", clk, &msg);
+    if (clk != 0) {
+        for (i = 0; i < info->miner_count; i++)
+            info->miners[i].sent_clock_code = sent_clock_code;
+    }
+    return true;
+}
