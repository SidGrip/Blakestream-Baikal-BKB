+static struct baikal_diag_nonce_out classify(int len, int unit, int chip, int work,
+                                             int present, int algo)
+{
+    struct baikal_diag_nonce_in in;
+    struct baikal_diag_nonce_out out;
+
+    memset(&in, 0, sizeof(in));
+    in.data_len = len;
+    in.unit_id = unit;
+    in.chip_id = chip;
+    in.work_idx = work;
+    in.work_fifo = 200;
+    in.work_present = present;
+    in.algo_match = algo;
+    expect(baikal_diag_classify_nonce(&in, &out) == 0, "classify returns");
+    return out;
+}
+
+static void test_classify(void)
+{
+    struct baikal_diag_nonce_out out;
+    struct baikal_diag_counters counters;
+    uint8_t fw = 9, hw = 9, bbg = 9, code = 9, count = 9, count_r = 9, ver = 9;
+    uint8_t info[7] = {1, 2, 3, 30, 64, 61, 0x51};
+    uint8_t chip = 1, work = 1, temp = 1, unit = 1;
+    uint32_t nonce = 1;
+    uint8_t result[8] = {0x78, 0x56, 0x34, 0x12, 15, 4, 40, 2};
+
+    out = classify(8, 2, 15, 4, 1, 1);
+    expect(out.submit && out.attribute && !out.invalid_id, "in-range id submits");
+    expect(out.unit == 2 && out.chip == 15, "raw id kept");
+
+    out = classify(8, 4, 0, 4, 1, 1);
+    expect(out.submit && !out.attribute && out.invalid_id, "unknown unit still submits");
+
+    out = classify(8, 0, 16, 4, 1, 1);
+    expect(out.submit && out.invalid_id, "unknown chip still submits");
+
+    out = classify(8, 0, 0, 200, 1, 1);
+    expect(!out.submit && out.kind == BAIKAL_DIAG_NONCE_BAD_WORKIDX, "work index 200 rejected");
+
+    out = classify(8, 0, 0, 255, 1, 1);
+    expect(out.kind == BAIKAL_DIAG_NONCE_BAD_WORKIDX, "work index 255 rejected");
+
+    out = classify(8, 0, 0, 3, 0, 1);
+    expect(!out.submit && out.kind == BAIKAL_DIAG_NONCE_MISSING, "missing work rejected");
+
+    out = classify(8, 0, 0, 3, 1, 0);
+    expect(!out.submit && out.kind == BAIKAL_DIAG_NONCE_ALGO, "algo mismatch rejected");
+
+    out = classify(7, 0, 0, 3, 1, 1);
+    expect(!out.submit && out.kind == BAIKAL_DIAG_NONCE_SHORT, "short result rejected");
+
+    baikal_diag_counters_init(&counters);
+    baikal_diag_count_nonce(&counters, &out);
+    out = classify(8, 9, 1, 1, 1, 1);
+    baikal_diag_count_nonce(&counters, &out);
+    out = classify(8, 0, 0, 400, 1, 1);
+    baikal_diag_count_nonce(&counters, &out);
+    out = classify(8, 0, 0, 1, 0, 1);
+    baikal_diag_count_nonce(&counters, &out);
+    out = classify(8, 0, 0, 1, 1, 0);
+    baikal_diag_count_nonce(&counters, &out);
+    expect(counters.short_reply == 1 && counters.invalid_id == 1 &&
+           counters.invalid_workidx == 1 && counters.missing_work == 1 &&
+           counters.algo_mismatch == 1, "discard classes stay separate");
+
+    expect(!baikal_diag_getinfo_fields(info, 6, &fw, &hw, &bbg, &code, &count, &count_r, &ver),
+           "short GET_INFO rejected");
+    expect(fw == 9 && count == 9 && count_r == 9 && ver == 9, "short GET_INFO writes nothing");
+    expect(baikal_diag_getinfo_fields(info, 7, &fw, &hw, &bbg, &code, &count, &count_r, &ver),
+           "GET_INFO length 7 accepted");
+    expect(fw == 1 && hw == 2 && bbg == 3 && code == 30 && count == 64 &&
+           count_r == 61 && ver == 0x51, "both counts and version");
+
+    expect(!baikal_diag_result_fields(result, 7, &chip, &work, &temp, &unit, &nonce),
+           "short result fields rejected");
+    expect(chip == 1 && temp == 1 && nonce == 1, "short result writes nothing");
+    expect(baikal_diag_result_fields(result, 8, &chip, &work, &temp, &unit, &nonce),
+           "result fields accepted");
+    expect(chip == 15 && work == 4 && temp == 40 && unit == 2 && nonce == 0x12345678,
+           "result layout");
+}
