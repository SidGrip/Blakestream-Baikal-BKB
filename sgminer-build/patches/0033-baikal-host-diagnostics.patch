+static void baikal_diag_note_route(struct cgpu_info *cgpu)
+{
+    struct baikal_info *info;
+    struct pool *pool = NULL;
+    char endpoint[BAIKAL_DIAG_ID_LEN];
+    char worker[BAIKAL_DIAG_ID_LEN];
+    int pool_no;
+    int miner_id;
+
+    if (!cgpu || !cgpu->drv || cgpu->drv->drv_id != DRIVER_baikalu)
+        return;
+    info = cgpu->device_data;
+    if (!info)
+        return;
+    miner_id = cgpu->miner_id;
+    pthread_mutex_lock(&info->diag_lock);
+    if (!info->diag_ready || miner_id < 0 || miner_id >= info->miner_count ||
+            miner_id >= BAIKAL_MAXMINERS) {
+        pthread_mutex_unlock(&info->diag_lock);
+        return;
+    }
+    pthread_mutex_unlock(&info->diag_lock);
+
+    pool_no = baikal_effective_pool(cgpu);
+    endpoint[0] = '\0';
+    worker[0] = '\0';
+    if (pool_no >= 0 && pool_no < total_pools && pools)
+        pool = pools[pool_no];
+    if (pool) {
+        pthread_mutex_lock(&pool->pool_lock);
+        baikal_diag_clean_endpoint(pool->rpc_url, endpoint, sizeof(endpoint));
+        snprintf(worker, sizeof(worker), "%s", pool->rpc_user ? pool->rpc_user : "");
+        pthread_mutex_unlock(&pool->pool_lock);
+    }
+
+    pthread_mutex_lock(&info->diag_lock);
+    if (info->diag_ready && miner_id >= 0 && miner_id < info->miner_count &&
+            miner_id < BAIKAL_MAXMINERS) {
+        baikal_diag_observe_route(&info->miners[miner_id].diag_activity,
+                                  pool_no, endpoint, worker);
+    }
+    pthread_mutex_unlock(&info->diag_lock);
+}
