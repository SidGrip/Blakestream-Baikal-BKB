+static void test_half_payload(void)
+{
+    uint8_t wire[128];
+    uint8_t decoded[64];
+    uint8_t miner = 0x5a, cmd = 0x5a, param = 0x5a, dest = 0x5a;
+    uint8_t saved_miner, saved_cmd, saved_param, saved_dest;
+    int dlen = 99;
+    int n;
+    uint8_t one[1] = {0x42};
+    int outlen = 0;
+
+    memset(decoded, 0xab, sizeof(decoded));
+    for (n = 8; n <= 128; n += 2) {
+        memset(wire, 0, sizeof(wire));
+        wire[0] = ':';
+        wire[n - 2] = '\r';
+        wire[n - 1] = '\n';
+        miner = cmd = param = dest = 0x5a;
+        dlen = 99;
+        decoded[0] = 0xab;
+        saved_miner = miner;
+        saved_cmd = cmd;
+        saved_param = param;
+        saved_dest = dest;
+        expect(baikal_diag_decode_rx(wire, n, &miner, &cmd, &param, &dest,
+                                     decoded, (int)sizeof(decoded), &dlen) < 0,
+               "odd payload length rejected");
+        expect(miner == saved_miner && cmd == saved_cmd && param == saved_param &&
+               dest == saved_dest && dlen == 99 && decoded[0] == 0xab,
+               "rejected frame writes nothing");
+    }
+
+    memset(wire, 0, sizeof(wire));
+    expect(baikal_diag_encode_tx(2, 5, 1, 0, NULL, 0, wire, (int)sizeof(wire), &outlen) == 0,
+           "empty payload encodes");
+    expect(outlen == 7, "empty frame is 7 bytes");
+    dlen = -1;
+    expect(baikal_diag_decode_rx(wire, outlen, &miner, &cmd, &param, &dest,
+                                 NULL, 0, &dlen) == outlen,
+           "empty frame decodes with no data buffer");
+    expect(dlen == 0 && miner == 2 && cmd == 5 && param == 1, "empty frame fields");
+
+    expect(baikal_diag_encode_tx(1, 4, 9, 0, one, 1, wire, (int)sizeof(wire), &outlen) == 0,
+           "one-byte payload encodes");
+    expect(outlen == 9 && ((outlen - 7) % 2) == 0, "one-byte frame is even");
+    expect(baikal_diag_decode_rx(wire, outlen, &miner, &cmd, &param, &dest,
+                                 decoded, (int)sizeof(decoded), &dlen) == outlen &&
+           dlen == 1 && decoded[0] == 0x42 && param == 9,
+           "one-byte frame round trip");
+
+    expect(baikal_diag_transfer_status(0, 6, 0) == -1, "short read status is failure");
+    expect(baikal_diag_transfer_status(0, 8, 0) == -1, "malformed frame status is failure");
+    expect(baikal_diag_transfer_status(-7, 0, 0) == -7, "usb failure status kept");
+    expect(baikal_diag_transfer_status(0, 7, 1) == 7, "full frame status is its byte count");
+}
