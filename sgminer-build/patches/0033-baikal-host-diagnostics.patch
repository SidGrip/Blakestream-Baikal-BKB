+static void baikal_diag_hash_executable(char out[65])
+{
+    static const char hex[] = "0123456789abcdef";
+    sph_sha256_context ctx;
+    unsigned char buf[4096], digest[32];
+    struct stat before, after;
+    FILE *fp;
+    size_t n, total = 0;
+    int i, valid;
+
+    out[0] = '\0';
+    fp = fopen("/proc/self/exe", "rb");
+    if (!fp)
+        return;
+    if (fstat(fileno(fp), &before) != 0 || !S_ISREG(before.st_mode) ||
+            before.st_size <= 0 || before.st_size > 64 * 1024 * 1024) {
+        fclose(fp);
+        return;
+    }
+    sph_sha256_init(&ctx);
+    while ((n = fread(buf, 1, sizeof(buf), fp)) != 0) {
+        total += n;
+        if (total > (size_t)before.st_size)
+            break;
+        sph_sha256(&ctx, buf, n);
+    }
+    valid = !ferror(fp) && total == (size_t)before.st_size &&
+        fstat(fileno(fp), &after) == 0 && before.st_dev == after.st_dev &&
+        before.st_ino == after.st_ino && before.st_size == after.st_size &&
+        before.st_mtime == after.st_mtime;
+    if (fclose(fp) != 0 || !valid)
+        return;
+    sph_sha256_close(&ctx, digest);
+    for (i = 0; i < 32; i++) {
+        out[i * 2] = hex[digest[i] >> 4];
+        out[i * 2 + 1] = hex[digest[i] & 15];
+    }
+    out[64] = '\0';
+}
