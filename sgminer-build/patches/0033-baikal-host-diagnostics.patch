+static void test_epochs(void)
+{
+    struct baikal_diag_activity st;
+    struct baikal_diag_stat_sample sample;
+    char endpoint[BAIKAL_DIAG_ID_LEN];
+
+    expect(baikal_diag_clean_endpoint("stratum+tcp://user:secret@pool.example:3334/job",
+                                      endpoint, sizeof(endpoint)) == 0,
+           "clean endpoint");
+    expect(strcmp(endpoint, "pool.example:3334") == 0, "endpoint is host:port");
+    expect(strstr(endpoint, "secret") == NULL && strstr(endpoint, "user") == NULL,
+           "endpoint has no userinfo");
+    expect(baikal_diag_clean_endpoint("user:secret@pool.example:3334",
+                                      endpoint, sizeof(endpoint)) == 0 &&
+           strcmp(endpoint, "pool.example:3334") == 0,
+           "userinfo stripped without a scheme");
+    expect(baikal_diag_clean_endpoint(
+               "http://quota:2;stratum+tcp://user:password@host:3334",
+               endpoint, sizeof(endpoint)) == 0 &&
+           strcmp(endpoint, "host:3334") == 0,
+           "legacy quota wrapper keeps the host");
+    expect(strstr(endpoint, "password") == NULL && strstr(endpoint, "quota") == NULL,
+           "legacy quota wrapper drops credentials");
+    expect(baikal_diag_clean_endpoint("stratum+tcp://host:3334?password=secret",
+                                      endpoint, sizeof(endpoint)) == 0 &&
+           strcmp(endpoint, "host:3334") == 0,
+           "query is stripped when there is no slash");
+    expect(baikal_diag_clean_endpoint("stratum+tcp://host:3334#frag",
+                                      endpoint, sizeof(endpoint)) == 0 &&
+           strcmp(endpoint, "host:3334") == 0,
+           "fragment is stripped when there is no slash");
+
+    baikal_diag_activity_init(&st);
+    expect(baikal_diag_observe_route(&st, 1, "stratum+tcp://u:secret@a.example:1", "worker") == 0 &&
+           st.route_epoch == 0, "first route is the baseline");
+    expect(strcmp(st.endpoint, "a.example:1") == 0 && strstr(st.endpoint, "secret") == NULL,
+           "stored route has no password");
+    expect(baikal_diag_observe_route(&st, 1, "a.example:1", "worker") == 0 &&
+           st.route_epoch == 0, "same cleaned route is not a change");
+    expect(baikal_diag_observe_route(&st, 2, "b.example:1", "worker") == 1 &&
+           st.route_epoch == 1, "route away increments");
+    expect(baikal_diag_observe_route(&st, 1, "a.example:1", "worker") == 1 &&
+           st.route_epoch == 2, "route back increments again");
+    expect(baikal_diag_observe_route(&st, 1, "a.example:1", "other") == 1 &&
+           st.route_epoch == 3, "worker change increments");
+    expect(baikal_diag_observe_route(&st, 1, "a.example:9", "other") == 1 &&
+           st.route_epoch == 4, "endpoint change increments");
+    expect(baikal_diag_observe_route(
+               &st, 1, "http://quota:2;stratum+tcp://user:password@a.example:9",
+               "other") == 0 &&
+           st.route_epoch == 4, "same host inside a quota wrapper is not a new route");
+    expect(baikal_diag_observe_route(
+               &st, 1, "http://quota:2;stratum+tcp://user:password@b.example:9",
+               "other") == 1 &&
+           st.route_epoch == 5, "another host inside a quota wrapper is a new route");
+
+    baikal_diag_activity_init(&st);
+    expect(baikal_diag_observe_enable(&st, 1) == 0 && st.enable_epoch == 0,
+           "first enablement is the baseline");
+    expect(baikal_diag_observe_enable(&st, 1) == 0 && st.enable_epoch == 0,
+           "steady enablement does not increment");
+    expect(baikal_diag_observe_enable(&st, 0) == 1 && st.enable_epoch == 1,
+           "disable increments");
+    expect(baikal_diag_observe_enable(&st, 1) == 1 && st.enable_epoch == 2,
+           "re-enable increments again");
+
+    baikal_diag_activity_init(&st);
+    sample = stat_sample(10, 320.0, 1000);
+    expect(baikal_diag_observe_stats(&st, &sample) == 0 && st.stat_epoch == 0,
+           "first stats sample is the baseline");
+    sample = stat_sample(11, 352.0, 1000);
+    expect(baikal_diag_observe_stats(&st, &sample) == 0 && st.stat_epoch == 0,
+           "increasing counters stay in the epoch");
+    sample = stat_sample(4, 352.0, 1000);
+    expect(baikal_diag_observe_stats(&st, &sample) == 1 && st.stat_epoch == 1,
+           "accepted decrease increments stat epoch");
+    sample = stat_sample(4, 100.0, 1000);
+    expect(baikal_diag_observe_stats(&st, &sample) == 1 && st.stat_epoch == 2,
+           "difficulty decrease increments stat epoch");
+    sample = stat_sample(4, 100.0, 2000);
+    expect(baikal_diag_observe_stats(&st, &sample) == 1 && st.stat_epoch == 3,
+           "device start change increments stat epoch");
+    expect(baikal_diag_observe_stats(&st, &sample) == 0 && st.stat_epoch == 3,
+           "repeat sample does not increment");
+
+    sample.rejected = 0;
+    expect(baikal_diag_observe_stats(&st, &sample) == 1 && st.stat_epoch == 4,
+           "rejected decrease increments stat epoch");
+    sample.hw = 0;
+    sample.rejected = 0;
+    sample.local_error = 3;
+    expect(baikal_diag_observe_stats(&st, &sample) == 0 && st.stat_epoch == 4,
+           "new local error does not look like a reset");
+    sample.local_error = 1;
+    expect(baikal_diag_observe_stats(&st, &sample) == 1 && st.stat_epoch == 5,
+           "local error decrease increments stat epoch");
+    sample.hw = 2;
+    expect(baikal_diag_observe_stats(&st, &sample) == 0 && st.stat_epoch == 5,
+           "hw increase stays in the epoch");
+    sample.hw = 0;
+    expect(baikal_diag_observe_stats(&st, &sample) == 1 && st.stat_epoch == 6,
+           "hw decrease increments stat epoch");
+    sample.local_nonce = 0;
+    expect(baikal_diag_observe_stats(&st, &sample) == 1 && st.stat_epoch == 7,
+           "local nonce decrease increments stat epoch");
+}
