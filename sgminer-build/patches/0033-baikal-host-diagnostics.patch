+static void wr_u16(uint8_t *p, unsigned v)
+{
+    p[0] = (uint8_t)(v & 0xff);
+    p[1] = (uint8_t)((v >> 8) & 0xff);
+}
+
+static void wr_u32(uint8_t *p, unsigned v)
+{
+    p[0] = (uint8_t)(v & 0xff);
+    p[1] = (uint8_t)((v >> 8) & 0xff);
+    p[2] = (uint8_t)((v >> 16) & 0xff);
+    p[3] = (uint8_t)((v >> 24) & 0xff);
+}
+
+static void wr_u64(uint8_t *p, uint64_t v)
+{
+    int i;
+
+    for (i = 0; i < 8; i++)
+        p[i] = (uint8_t)((v >> (8 * i)) & 0xff);
+}
+
+static void wr_i32(uint8_t *p, int v)
+{
+    wr_u32(p, (unsigned)v);
+}
+
+static void wr_i16(uint8_t *p, int v)
+{
+    wr_u16(p, (unsigned)(uint16_t)(int16_t)v);
+}
+
+static unsigned rd_u16(const uint8_t *p)
+{
+    return (unsigned)p[0] | ((unsigned)p[1] << 8);
+}
+
+static unsigned rd_u32(const uint8_t *p)
+{
+    return (unsigned)p[0] | ((unsigned)p[1] << 8) |
+           ((unsigned)p[2] << 16) | ((unsigned)p[3] << 24);
+}
+
+static uint64_t rd_u64(const uint8_t *p)
+{
+    uint64_t v = 0;
+    int i;
+
+    for (i = 0; i < 8; i++)
+        v |= ((uint64_t)p[i]) << (8 * i);
+    return v;
+}
+
+static int rd_i32(const uint8_t *p)
+{
+    return (int)rd_u32(p);
+}
+
+static int rd_i16(const uint8_t *p)
+{
+    return (int)(int16_t)rd_u16(p);
+}
+
+int baikal_diag_classify_nonce(const struct baikal_diag_nonce_in *in,
+                               struct baikal_diag_nonce_out *out)
+{
+    if (!in || !out)
+        return -1;
+
+    memset(out, 0, sizeof(*out));
+    out->unit = in->unit_id;
+    out->chip = in->chip_id;
+
+    if (in->data_len < BAIKAL_DIAG_RESULT_MIN) {
+        out->kind = BAIKAL_DIAG_NONCE_SHORT;
+        return 0;
+    }
+    if (in->work_fifo <= 0 || in->work_idx < 0 || in->work_idx >= in->work_fifo) {
+        out->kind = BAIKAL_DIAG_NONCE_BAD_WORKIDX;
+        return 0;
+    }
+    if (!in->work_present) {
+        out->kind = BAIKAL_DIAG_NONCE_MISSING;
+        return 0;
+    }
+    if (!in->algo_match) {
+        out->kind = BAIKAL_DIAG_NONCE_ALGO;
+        return 0;
+    }
+
+    out->kind = BAIKAL_DIAG_NONCE_SUBMIT;
+    out->submit = 1;
+    out->attribute = (in->unit_id >= 0 && in->unit_id < BAIKAL_DIAG_UNITS &&
+                      in->chip_id >= 0 && in->chip_id < BAIKAL_DIAG_CHIPS);
+    out->invalid_id = !out->attribute;
+    return 0;
+}
+
+void baikal_diag_count_nonce(struct baikal_diag_counters *counters,
+                             const struct baikal_diag_nonce_out *out)
+{
+    if (!counters || !out)
+        return;
+
+    switch (out->kind) {
+    case BAIKAL_DIAG_NONCE_SHORT:
+        counters->short_reply++;
+        break;
+    case BAIKAL_DIAG_NONCE_BAD_WORKIDX:
+        counters->invalid_workidx++;
+        break;
+    case BAIKAL_DIAG_NONCE_MISSING:
+        counters->missing_work++;
+        break;
+    case BAIKAL_DIAG_NONCE_ALGO:
+        counters->algo_mismatch++;
+        break;
+    case BAIKAL_DIAG_NONCE_SUBMIT:
+        if (out->invalid_id)
+            counters->invalid_id++;
+        break;
+    default:
+        break;
+    }
+}
+
+void baikal_diag_counters_init(struct baikal_diag_counters *counters)
+{
+    if (!counters)
+        return;
+    memset(counters, 0, sizeof(*counters));
+    counters->last_poll_mono_us = -1;
+    counters->attempted_clock_code = -1;
+}
+
+void baikal_diag_note_poll(struct baikal_diag_counters *counters, uint64_t now_us)
+{
+    if (!counters)
+        return;
+    if (counters->last_poll_mono_us >= 0 &&
+            now_us >= (uint64_t)counters->last_poll_mono_us) {
+        uint64_t gap = now_us - (uint64_t)counters->last_poll_mono_us;
+
+        counters->poll_gap_us_last = gap;
+        if (gap > counters->poll_gap_us_max)
+            counters->poll_gap_us_max = gap;
+    }
+    counters->last_poll_mono_us = (int64_t)now_us;
+}
+
+void baikal_diag_note_duration(uint64_t *sum, uint64_t *max_us, uint64_t *count,
+                               uint64_t us)
+{
+    if (!sum || !max_us || !count)
+        return;
+    *sum += us;
+    if (us > *max_us)
+        *max_us = us;
+    (*count)++;
+}
+
+int baikal_diag_getinfo_fields(const uint8_t *data, int len,
+                               uint8_t *fw, uint8_t *hw, uint8_t *bbg,
+                               uint8_t *clock_code, uint8_t *asic_count,
+                               uint8_t *asic_count_r, uint8_t *asic_ver)
+{
+    if (!data || len < BAIKAL_DIAG_GETINFO_MIN)
+        return 0;
+    if (fw)
+        *fw = data[0];
+    if (hw)
+        *hw = data[1];
+    if (bbg)
+        *bbg = data[2];
+    if (clock_code)
+        *clock_code = data[3];
+    if (asic_count)
+        *asic_count = data[4];
+    if (asic_count_r)
+        *asic_count_r = data[5];
+    if (asic_ver)
+        *asic_ver = data[6];
+    return 1;
+}
+
+int baikal_diag_result_fields(const uint8_t *data, int len,
+                              uint8_t *chip, uint8_t *work_idx, uint8_t *temp,
+                              uint8_t *unit, uint32_t *nonce)
+{
+    if (!data || len < BAIKAL_DIAG_RESULT_MIN)
+        return 0;
+    if (chip)
+        *chip = data[4];
+    if (work_idx)
+        *work_idx = data[5];
+    if (temp)
+        *temp = data[6];
+    if (unit)
+        *unit = data[7];
+    if (nonce)
+        memcpy(nonce, data, sizeof(*nonce));
+    return 1;
+}
+
+int baikal_diag_encode_tx(uint8_t miner, uint8_t cmd, uint8_t param, uint8_t dest,
+                          const uint8_t *data, int len,
+                          uint8_t *out, int outcap, int *outlen)
+{
+    int pos = 0;
+    int i;
+
+    if (!out || !outlen || len < 0 || outcap < 7)
+        return -1;
+    if (len > (outcap - 7) / 2)
+        return -1;
+    if (len > 0 && !data)
+        return -1;
+
+    out[pos++] = ':';
+    out[pos++] = miner;
+    out[pos++] = cmd;
+    out[pos++] = param;
+    out[pos++] = dest;
+    for (i = 0; i < len; i++, pos += 2) {
+        out[pos] = 0;
+        out[pos + 1] = data[i];
+    }
+    out[pos++] = '\r';
+    out[pos++] = '\n';
+    *outlen = pos;
+    return 0;
+}
+
+int baikal_diag_decode_rx(const uint8_t *buf, int amount,
+                          uint8_t *miner, uint8_t *cmd, uint8_t *param, uint8_t *dest,
+                          uint8_t *data, int datacap, int *dlen)
+{
+    int pos = 1;
+    int len;
+    int payload;
+
+    if (!buf || !miner || !cmd || !param || !dest || !dlen)
+        return -1;
+    if (amount < 7 || ((amount - 7) & 1))
+        return -1;
+    if (buf[0] != ':' || buf[amount - 2] != '\r' || buf[amount - 1] != '\n')
+        return -1;
+
+    payload = (amount - 7) / 2;
+    if (payload < 0 || (payload > 0 && (!data || payload > datacap)))
+        return -1;
+
+    *miner = buf[pos++];
+    *cmd = buf[pos++];
+    *param = buf[pos++];
+    *dest = buf[pos++];
+    for (len = 0; len < payload; len++, pos += 2)
+        data[len] = buf[pos + 1];
+    *dlen = payload;
+    return amount;
+}
+
+int baikal_diag_clean_endpoint(const char *url, char *dst, size_t dst_len)
+{
+    const char *start;
+    const char *last_scheme = NULL;
+    const char *scan;
+    const char *end;
+    const char *at = NULL;
+    const char *p;
+    size_t n;
+
+    if (!dst || dst_len == 0)
+        return -1;
+    dst[0] = '\0';
+    if (!url || !url[0])
+        return 0;
+
+    /* The last scheme wins, so a legacy quota wrapper does not hide the host. */
+    for (scan = url; (scan = strstr(scan, "://")) != NULL; scan += 3)
+        last_scheme = scan;
+    start = last_scheme ? last_scheme + 3 : url;
+    end = start + strcspn(start, "/?#");
+    for (p = start; p < end; p++) {
+        if (*p == '@')
+            at = p;
+    }
+    if (at)
+        start = at + 1;
+    n = (size_t)(end - start);
+    while (n > 0 && (start[n - 1] == ' ' || start[n - 1] == '\r' || start[n - 1] == '\n'))
+        n--;
+    if (n >= dst_len)
+        n = dst_len - 1;
+    memcpy(dst, start, n);
+    dst[n] = '\0';
+    return 0;
+}
+
+int baikal_diag_transfer_status(int usb_err, int amount, int frame_ok)
+{
+    if (usb_err < 0)
+        return usb_err;
+    if (!frame_ok || amount < 7)
+        return -1;
+    return amount;
+}
+
+static int diag_clamp_count(int value)
+{
+    if (value < 0)
+        return 0;
+    if (value > 65535)
+        return 65535;
+    return value;
+}
+
+void baikal_diag_classify_tx(int usb_err, int amount, int intended,
+                             struct baikal_diag_xfer *out)
+{
+    if (!out)
+        return;
+    memset(out, 0, sizeof(*out));
+    out->intended = diag_clamp_count(intended);
+    out->transferred = diag_clamp_count(amount);
+    if (usb_err < 0) {
+        out->caller_rc = usb_err;
+        out->status = usb_err;
+        out->flags = (uint8_t)(BAIKAL_DIAG_F_FAIL | BAIKAL_DIAG_F_TX_ONLY);
+        out->count_usb = 1;
+        return;
+    }
+    if (amount < intended || amount < 0) {
+        out->caller_rc = -1;
+        out->status = -1;
+        out->flags = (uint8_t)(BAIKAL_DIAG_F_FAIL | BAIKAL_DIAG_F_SHORT | BAIKAL_DIAG_F_TX_ONLY);
+        return;
+    }
+    out->caller_rc = amount;
+    out->status = amount;
+    out->frame_ok = 1;
+}
+
+void baikal_diag_classify_rx(int usb_err, int amount, int intended,
+                             int decoded_len, int mismatch, int min_data,
+                             struct baikal_diag_xfer *out)
+{
+    int payload_short = 0;
+
+    if (!out)
+        return;
+    memset(out, 0, sizeof(*out));
+    out->intended = diag_clamp_count(intended);
+    out->transferred = diag_clamp_count(amount);
+    if (usb_err < 0) {
+        out->caller_rc = usb_err;
+        out->status = usb_err;
+        out->flags = BAIKAL_DIAG_F_FAIL;
+        out->count_usb = 1;
+        return;
+    }
+    if (amount < 7 || decoded_len < 0) {
+        out->caller_rc = -1;
+        out->status = -1;
+        out->flags = (uint8_t)(BAIKAL_DIAG_F_FAIL | BAIKAL_DIAG_F_SHORT);
+        out->count_short = 1;
+        return;
+    }
+    if (mismatch)
+        out->flags = (uint8_t)(out->flags | BAIKAL_DIAG_F_MISMATCH);
+    if (min_data > 0 && decoded_len < min_data)
+        payload_short = 1;
+    if (mismatch || payload_short) {
+        out->caller_rc = -1;
+        out->status = -1;
+        out->flags = (uint8_t)(out->flags | BAIKAL_DIAG_F_FAIL);
+        if (payload_short)
+            out->flags = (uint8_t)(out->flags | BAIKAL_DIAG_F_SHORT);
+        return;
+    }
+    out->caller_rc = amount;
+    out->status = amount;
+    out->frame_ok = 1;
+}
+
+int baikal_diag_accept_frame(int caller_rc)
+{
+    return caller_rc >= 7;
+}
+
+int baikal_diag_result_disposition(int caller_rc, int flags, int decoded,
+                                   int miner_ok, int cmd_ok, int data_len,
+                                   int min_data)
+{
+    int matched = miner_ok && cmd_ok;
+    int below_min = min_data > 0 && data_len < min_data;
+
+    if (baikal_diag_accept_frame(caller_rc)) {
+        if (!matched)
+            return BAIKAL_DIAG_RESULT_MISMATCH;
+        if (below_min)
+            return BAIKAL_DIAG_RESULT_SHORT;
+        return BAIKAL_DIAG_RESULT_FULL;
+    }
+    if ((flags & BAIKAL_DIAG_F_MISMATCH) || (decoded && !matched))
+        return BAIKAL_DIAG_RESULT_MISMATCH;
+    if ((flags & BAIKAL_DIAG_F_SHORT) && decoded && matched &&
+            data_len > 0 && below_min)
+        return BAIKAL_DIAG_RESULT_SHORT;
+    return BAIKAL_DIAG_RESULT_ABORT;
+}
+
+int baikal_diag_advance_work(int send_rc, int read_rc, int ack_param,
+                             int work_idx, int fifo, int *out_idx)
+{
+    if (out_idx)
+        *out_idx = work_idx;
+    (void)ack_param;
+    if (send_rc < 0 || !baikal_diag_accept_frame(read_rc) || fifo <= 0)
+        return 0;
+    work_idx++;
+    if (work_idx >= fifo)
+        work_idx = 0;
+    if (out_idx)
+        *out_idx = work_idx;
+    return 1;
+}
+
+void baikal_diag_mark_info_failed(struct baikal_diag_counters *counters)
+{
+    if (counters)
+        counters->last_info_ok = 0;
+}
+
+int baikal_diag_sync_close_with(int fd, int (*do_sync)(int), int (*do_close)(int))
+{
+    int rc_sync;
+    int rc_close;
+
+    if (fd < 0 || !do_sync || !do_close)
+        return -1;
+    rc_sync = do_sync(fd);
+    rc_close = do_close(fd);
+    if (rc_sync != 0 || rc_close != 0)
+        return -1;
+    return 0;
+}
+
+int baikal_diag_sync_close(int fd)
+{
+    return baikal_diag_sync_close_with(fd, fsync, close);
+}
