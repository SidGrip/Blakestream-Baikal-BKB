+    struct baikal_diag_xfer tx;
+    struct baikal_diag_xfer rx;
+    int next = -1;
+
+    baikal_diag_classify_tx(0, 4, 20, &tx);
+    expect(tx.caller_rc < 0 && tx.status == -1, "short write is not success");
+    expect(tx.transferred == 4 && tx.intended == 20, "short write keeps both lengths");
+    expect(tx.count_usb == 0, "error 0 short write is not a USB error count");
+    expect((tx.flags & BAIKAL_DIAG_F_FAIL) && (tx.flags & BAIKAL_DIAG_F_SHORT) &&
+           (tx.flags & BAIKAL_DIAG_F_TX_ONLY), "short write is fail short tx-only");
+    expect(!baikal_diag_accept_frame(tx.caller_rc), "short write is not a frame");
+
+    baikal_diag_classify_tx(-7, 4, 20, &tx);
+    expect(tx.caller_rc == -7 && tx.status == -7, "partial write keeps the USB error");
+    expect(tx.transferred == 4 && tx.intended == 20, "partial write plus error keeps the count");
+    expect(tx.count_usb == 1, "negative USB write is a USB error");
+    expect((tx.flags & BAIKAL_DIAG_F_FAIL) && (tx.flags & BAIKAL_DIAG_F_TX_ONLY),
+           "USB write failure is tx-only");
+
+    baikal_diag_classify_tx(0, 20, 20, &tx);
+    expect(tx.caller_rc == 20 && tx.frame_ok && tx.count_usb == 0, "full write succeeds");
+
+    baikal_diag_classify_rx(0, 3, 23, -1, 0, 8, &rx);
+    expect(rx.caller_rc < 0 && rx.count_short == 1 && rx.count_usb == 0,
+           "transport short is a short reply, not a USB error");
+    expect(baikal_diag_result_disposition(rx.caller_rc, rx.flags, 0, 1, 1, 0,
+                                          BAIKAL_DIAG_RESULT_MIN) ==
+           BAIKAL_DIAG_RESULT_ABORT,
+           "transport short aborts the poll");
+
+    baikal_diag_classify_rx(-5, 4, 23, -1, 0, 8, &rx);
+    expect(rx.caller_rc == -5 && rx.transferred == 4 && rx.intended == 23 &&
+           rx.count_usb == 1 && rx.count_short == 0,
+           "read error keeps transferred, intended, and USB status");
+    expect(baikal_diag_result_disposition(rx.caller_rc, rx.flags, 0, 1, 1, 0,
+                                          BAIKAL_DIAG_RESULT_MIN) ==
+           BAIKAL_DIAG_RESULT_ABORT,
+           "USB read error aborts the poll");
+
+    baikal_diag_classify_rx(0, 21, 23, 8, 1, 8, &rx);
+    expect(rx.caller_rc < 0 && rx.count_short == 0 &&
+           (rx.flags & BAIKAL_DIAG_F_MISMATCH),
+           "mismatched frame is negative and is not a short reply");
+    expect(baikal_diag_result_disposition(rx.caller_rc, rx.flags, 1, 0, 0, 8,
+                                          BAIKAL_DIAG_RESULT_MIN) ==
+           BAIKAL_DIAG_RESULT_MISMATCH,
+           "mismatch continues to the next board");
+
+    baikal_diag_classify_rx(0, 15, 23, 4, 0, 8, &rx);
+    expect(rx.caller_rc < 0 && rx.count_short == 0 &&
+           (rx.flags & BAIKAL_DIAG_F_SHORT) && (rx.flags & BAIKAL_DIAG_F_FAIL),
+           "decoded payload short is a caller short, not a transport short");
+    expect(baikal_diag_result_disposition(rx.caller_rc, rx.flags, 1, 1, 1, 4,
+                                          BAIKAL_DIAG_RESULT_MIN) ==
+           BAIKAL_DIAG_RESULT_SHORT,
+           "decoded payload short still honors work-request bits");
+    expect(baikal_diag_result_disposition(rx.caller_rc, rx.flags, 1, 1, 1, 0,
+                                          BAIKAL_DIAG_RESULT_MIN) ==
+           BAIKAL_DIAG_RESULT_ABORT,
+           "decoded empty payload aborts");
+
+    baikal_diag_classify_rx(0, 8, 23, -1, 0, 8, &rx);
+    expect(rx.count_short == 1 &&
+           baikal_diag_result_disposition(rx.caller_rc, rx.flags, 0, 1, 1, 0,
+                                          BAIKAL_DIAG_RESULT_MIN) ==
+           BAIKAL_DIAG_RESULT_ABORT,
+           "undecodable frame aborts and counts short once");
+
+    baikal_diag_classify_rx(0, 23, 23, 8, 0, 8, &rx);
+    expect(baikal_diag_accept_frame(rx.caller_rc) &&
+           baikal_diag_result_disposition(rx.caller_rc, rx.flags, 1, 1, 1, 8,
+                                          BAIKAL_DIAG_RESULT_MIN) ==
+           BAIKAL_DIAG_RESULT_FULL,
+           "full matching result is success");
+    expect(baikal_diag_result_disposition(rx.caller_rc, rx.flags, 1, 0, 1, 8,
+                                          BAIKAL_DIAG_RESULT_MIN) ==
+           BAIKAL_DIAG_RESULT_MISMATCH,
+           "accepted bytes with the wrong miner are still a mismatch");
+
+    expect(!baikal_diag_accept_frame(0) && !baikal_diag_accept_frame(6) &&
+           !baikal_diag_accept_frame(-1) && baikal_diag_accept_frame(7),
+           "only a 7-byte-or-longer return is a frame");
+
+    expect(baikal_diag_advance_work(20, 7, 30, 3, 200, &next) == 1 && next == 4,
+           "ACK parameter 30 is not a clock and is not the next index");
+    expect(baikal_diag_advance_work(20, -1, 30, 3, 200, &next) == 0 && next == 3,
+           "negative read does not rotate work");
+    expect(baikal_diag_advance_work(-1, 7, 1, 3, 200, &next) == 0 && next == 3,
+           "failed send does not rotate work");
+    expect(baikal_diag_advance_work(20, 7, 30, 199, 200, &next) == 1 && next == 0,
+           "work index wraps the FIFO");
+}
+
+static int sync_calls;
+static int close_calls;
+static int sync_rc;
+static int close_rc;
+
+static int mock_sync(int fd)
+{
+    (void)fd;
+    sync_calls++;
+    return sync_rc;
+}
+
+static int mock_close(int fd)
+{
+    (void)fd;
+    close_calls++;
+    return close_rc;
+}
+
+static void test_info_and_close(void)
+{
+    struct baikal_diag_counters counters;
+
+    baikal_diag_counters_init(&counters);
+    counters.info_valid = 1;
+    counters.last_info_ok = 1;
+    counters.short_reply = 4;
+    counters.attempted_clock_code = 30;
+    baikal_diag_mark_info_failed(&counters);
+    expect(counters.last_info_ok == 0 && counters.info_valid == 1 &&
+           counters.short_reply == 4 && counters.attempted_clock_code == 30,
+           "GET_INFO failure clears only last-ok");
+
+    sync_calls = close_calls = 0;
+    sync_rc = -1;
+    close_rc = 0;
+    expect(baikal_diag_sync_close_with(3, mock_sync, mock_close) == -1 &&
+           sync_calls == 1 && close_calls == 1,
+           "fsync failure still closes");
+    sync_rc = 0;
+    close_rc = -1;
+    expect(baikal_diag_sync_close_with(3, mock_sync, mock_close) == -1 &&
+           close_calls == 2,
+           "close failure is reported");
+    close_rc = 0;
+    expect(baikal_diag_sync_close_with(3, mock_sync, mock_close) == 0 &&
+           sync_calls == 3 && close_calls == 3,
+           "sync and close both succeed once each");
+    expect(baikal_diag_sync_close_with(-1, mock_sync, mock_close) == -1 &&
+           sync_calls == 3 && close_calls == 3,
+           "invalid fd does not call sync or close");
+}
+
+static int hash_held;
+static int lock_order_ok;
+static int hash_locks;
+static int stats_locks;
+static struct baikal_diag_share_raw share_src;
+
+static void lock_hash(void)
+{
+    hash_held = 1;
+    hash_locks++;
+}
+
+static void unlock_hash(void)
+{
+    hash_held = 0;
+}
+
+static void lock_stats(void)
+{
+    if (!hash_held)
+        lock_order_ok = 0;
+    stats_locks++;
+}
+
+static void unlock_stats(void)
+{
+    share_src.accepted = 99;
+    share_src.diff_accepted = 9.0;
+}
+
+static void load_share(struct baikal_diag_share_raw *raw, void *user)
+{
+    (void)user;
+    *raw = share_src;
+}
+
+static void test_share_epochs_and_route(void)
+{
+    struct baikal_diag_share_view view;
+    struct baikal_diag_activity st;
+    struct baikal_diag_stat_sample sample;
+    char endpoint[BAIKAL_DIAG_ID_LEN];
+    int valid = 1;
+    double elapsed;
+    uint32_t generation = 0xffffffffu;
+
+    memset(&share_src, 0, sizeof(share_src));
+    share_src.accepted = 3;
+    share_src.rejected = -2;
+    share_src.hw = 4;
+    share_src.diff_accepted = 12.5;
+    share_src.diff_rejected = 1.5;
+    share_src.start_sec = 50;
+    share_src.start_usec = 250000;
+    hash_held = 0;
+    lock_order_ok = 1;
+    hash_locks = 0;
+    stats_locks = 0;
+    expect(baikal_diag_copy_share(&view, load_share, NULL,
+                                  lock_hash, unlock_hash, lock_stats, unlock_stats) == 0,
+           "copy share returns");
+    expect(hash_locks == 1 && stats_locks == 1 && lock_order_ok && !hash_held,
+           "stats lock is taken while hash lock is held, then both release");
+    expect(view.valid == 1 && view.accepted == 3 && view.rejected == 0 &&
+           view.hw == 4 && view.diff_accepted == 12.5 && view.diff_rejected == 1.5 &&
+           view.start_sec == 50,
+           "snapshot does not follow writes after the copy");
+    expect(baikal_diag_copy_share(&view, load_share, NULL, NULL, NULL, NULL, NULL) == 0 &&
+           view.valid == 0,
+           "missing lock functions produce an invalid snapshot");
+
+    valid = 1;
+    elapsed = baikal_diag_device_elapsed(0, 0, 80, 0, &valid);
+    expect(elapsed == 0 && valid == 0, "unset device start is not elapsed");
+    elapsed = baikal_diag_device_elapsed(50, 0, 50, 1000, &valid);
+    expect(valid == 1 && elapsed == 1.0, "sub-second device elapsed floors to 1");
+    elapsed = baikal_diag_device_elapsed(50, 250000, 53, 250000, &valid);
+    expect(valid == 1 && elapsed == 3.0, "device elapsed is start to now");
+
+    baikal_diag_activity_init(&st);
+    expect(baikal_diag_event_stats_reset(&st) == 0 && st.stat_epoch == 0,
+           "reset before the first sample is not an epoch");
+    memset(&sample, 0, sizeof(sample));
+    sample.accepted = 5;
+    sample.diff_accepted = 10;
+    sample.local_nonce = 7;
+    sample.device_start_sec = 50;
+    expect(baikal_diag_observe_stats(&st, &sample) == 0 && st.stat_epoch == 0,
+           "first stats sample is the baseline");
+    expect(baikal_diag_event_stats_reset(&st) == 1 && st.stat_epoch == 1 &&
+           st.stat_sample.accepted == 0 && st.stat_sample.diff_accepted == 0 &&
+           st.stat_sample.local_nonce == 7,
+           "reset event zeros share counters once and keeps local nonces");
+    sample.accepted = 6;
+    sample.diff_accepted = 11;
+    expect(baikal_diag_observe_stats(&st, &sample) == 0 && st.stat_epoch == 1,
+           "recovery after a reset event does not increment again");
+
+    baikal_diag_activity_init(&st);
+    expect(baikal_diag_observe_enable(&st, 1) == 0 && st.enable_epoch == 0,
+           "first enablement is the baseline");
+    expect(baikal_diag_observe_enable(&st, 0) == 1 && st.enable_epoch == 1,
+           "disable increments");
+    expect(baikal_diag_observe_enable(&st, 1) == 1 && st.enable_epoch == 2,
+           "enable after disable increments again");
+    expect(baikal_diag_observe_enable(&st, 1) == 0 && st.enable_epoch == 2,
+           "a repeated enable does not increment");
+
+    expect(baikal_diag_clean_endpoint(
+               "http://quota:2;stratum+tcp://user:password@host:3334",
+               endpoint, sizeof(endpoint)) == 0 &&
+           strcmp(endpoint, "host:3334") == 0,
+           "legacy quota wrapper stores host:port");
+    expect(strstr(endpoint, "password") == NULL && strstr(endpoint, "quota") == NULL,
+           "legacy quota wrapper removes credentials");
+    expect(baikal_diag_clean_endpoint("stratum+tcp://host:3334?password=secret",
+                                      endpoint, sizeof(endpoint)) == 0 &&
+           strcmp(endpoint, "host:3334") == 0,
+           "query without a slash is removed");
+
+    baikal_diag_activity_init(&st);
+    expect(baikal_diag_observe_route(&st, 1, "stratum+tcp://user:password@a.example:9",
+                                     "worker") == 0 &&
+           st.route_epoch == 0 && strcmp(st.endpoint, "a.example:9") == 0,
+           "first route stores the cleaned host");
+    expect(baikal_diag_observe_route(
+               &st, 1, "http://quota:2;stratum+tcp://user:password@a.example:9",
+               "worker") == 0 &&
+           st.route_epoch == 0,
+           "same host inside a quota wrapper is not a new route");
+    expect(baikal_diag_observe_route(
+               &st, 2, "http://quota:2;stratum+tcp://user:password@b.example:9",
+               "worker") == 1 &&
+           st.route_epoch == 1 && strcmp(st.endpoint, "b.example:9") == 0,
+           "a different wrapped host is a new route");
+    expect(baikal_diag_observe_route(&st, 1, "a.example:9", "worker") == 1 &&
+           st.route_epoch == 2,
+           "route back increments again");
+
+    expect(baikal_diag_bump_u32(&generation) == 1 && generation == 1,
+           "generation wraps past zero");
+}
+
+struct trace_seen {
+    int calls;
+    uint16_t tx_transferred;
+    uint16_t tx_intended;
+    int tx_status;
+    uint8_t flags;
+};
+
+static int on_trace(const struct baikal_diag_trace_view *view, void *user)
+{
+    struct trace_seen *seen = user;
+
+    seen->calls++;
+    seen->tx_transferred = view->tx_transferred;
+    seen->tx_intended = view->tx_intended;
+    seen->tx_status = view->tx_status;
+    seen->flags = view->flags;
+    return 0;
+}
+
+static void test_trace_partial(void)
+{
+    struct baikal_diag_trace trace;
+    struct baikal_diag_trace_rec rec;
+    struct trace_seen seen;
+    uint8_t *copy = NULL;
+    uint32_t copy_len = 0;
+    uint8_t tx[4] = {1, 2, 3, 4};
+    int enabled = -1;
+
+    memset(&trace, 0, sizeof(trace));
+    expect(baikal_diag_trace_init(&trace) == 0, "trace init");
+    expect(baikal_diag_trace_enabled(&trace) == 0, "trace starts disabled");
+    expect(baikal_diag_trace_open(&trace, BAIKAL_DIAG_TRACE_SLOT, 0) == 0,
+           "open one slot while off");
+    expect(baikal_diag_trace_enabled(&trace) == 0, "open off stays off");
+    expect(baikal_diag_trace_set(&trace, 1) == 0 && baikal_diag_trace_enabled(&trace) == 1,
+           "enable is visible through the atomic reader");
+
+    memset(&rec, 0, sizeof(rec));
+    rec.tx = tx;
+    rec.tx_len = 4;
+    rec.tx_status = -7;
+    rec.tx_transferred = 4;
+    rec.tx_intended = 20;
+    rec.rx_status = 0;
+    rec.flags = (uint8_t)(BAIKAL_DIAG_F_FAIL | BAIKAL_DIAG_F_TX_ONLY);
+    expect(baikal_diag_trace_append(&trace, &rec) == 0, "append partial write");
+    expect(baikal_diag_trace_copy(&trace, &copy, &copy_len, NULL, NULL, NULL, NULL,
+                                  NULL, &enabled) == 0 &&
+           enabled == 1 && copy != NULL,
+           "copy partial record");
+    memset(&seen, 0, sizeof(seen));
+    expect(baikal_diag_trace_walk(copy, copy_len, on_trace, &seen) == 0 &&
+           seen.calls == 1 && seen.tx_transferred == 4 && seen.tx_intended == 20 &&
+           seen.tx_status == -7,
+           "walk keeps transferred, intended, and USB status");
+    free(copy);
+    expect(baikal_diag_trace_set(&trace, 0) == 0 && baikal_diag_trace_enabled(&trace) == 0,
+           "disable is visible through the atomic reader");
+    baikal_diag_trace_free(&trace);
+}
+
+int main(void)
+{
+    test_usb_results();
+    test_info_and_close();
+    test_share_epochs_and_route();
+    test_trace_partial();
+    if (failures) {
+        fprintf(stderr, "FAIL baikal diag driver path (%d)\n", failures);
+        return 1;
+    }
+    printf("PASS baikal diag driver path\n");
+    return 0;
+}
