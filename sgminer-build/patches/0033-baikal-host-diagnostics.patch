+static struct baikal_diag_stat_sample stat_sample(uint64_t accepted, double diff,
+                                                   uint64_t start_sec)
+{
+    struct baikal_diag_stat_sample sample;
+
+    memset(&sample, 0, sizeof(sample));
+    sample.accepted = accepted;
+    sample.rejected = accepted;
+    sample.hw = 0;
+    sample.local_nonce = accepted;
+    sample.local_error = 0;
+    sample.diff_accepted = diff;
+    sample.diff_rejected = 0;
+    sample.device_start_sec = start_sec;
+    return sample;
+}
