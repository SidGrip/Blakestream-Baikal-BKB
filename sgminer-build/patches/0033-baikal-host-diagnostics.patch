+static void diag_copy_text(char *dst, size_t dst_len, const char *src)
+{
+    size_t n;
+
+    if (!dst || dst_len == 0)
+        return;
+    if (!src)
+        src = "";
+    n = strlen(src);
+    if (n >= dst_len)
+        n = dst_len - 1;
+    memcpy(dst, src, n);
+    dst[n] = '\0';
+}
+
+void baikal_diag_activity_init(struct baikal_diag_activity *st)
+{
+    if (!st)
+        return;
+    memset(st, 0, sizeof(*st));
+}
+
+int baikal_diag_observe_route(struct baikal_diag_activity *st, int pool_no,
+                              const char *endpoint, const char *worker)
+{
+    char ep[BAIKAL_DIAG_ID_LEN];
+    char wk[BAIKAL_DIAG_ID_LEN];
+
+    if (!st)
+        return -1;
+    if (baikal_diag_clean_endpoint(endpoint, ep, sizeof(ep)) != 0)
+        return -1;
+    diag_copy_text(wk, sizeof(wk), worker);
+    if (!st->route_ready) {
+        st->route_ready = 1;
+        st->pool_no = pool_no;
+        memcpy(st->endpoint, ep, sizeof(st->endpoint));
+        memcpy(st->worker, wk, sizeof(st->worker));
+        return 0;
+    }
+    if (st->pool_no == pool_no &&
+            strcmp(st->endpoint, ep) == 0 &&
+            strcmp(st->worker, wk) == 0)
+        return 0;
+    st->pool_no = pool_no;
+    memcpy(st->endpoint, ep, sizeof(st->endpoint));
+    memcpy(st->worker, wk, sizeof(st->worker));
+    st->route_epoch++;
+    st->share_valid = 0;
+    st->elapsed_valid = 0;
+    return 1;
+}
+
+int baikal_diag_observe_enable(struct baikal_diag_activity *st, int enabled)
+{
+    int on = enabled ? 1 : 0;
+
+    if (!st)
+        return -1;
+    if (!st->enable_ready) {
+        st->enable_ready = 1;
+        st->enabled = on;
+        return 0;
+    }
+    if (st->enabled == on)
+        return 0;
+    st->enabled = on;
+    st->enable_epoch++;
+    st->share_valid = 0;
+    st->elapsed_valid = 0;
+    return 1;
+}
+
+int baikal_diag_event_stats_reset(struct baikal_diag_activity *st)
+{
+    if (!st)
+        return -1;
+    if (!st->stat_ready)
+        return 0;
+    st->stat_sample.accepted = 0;
+    st->stat_sample.rejected = 0;
+    st->stat_sample.hw = 0;
+    st->stat_sample.diff_accepted = 0;
+    st->stat_sample.diff_rejected = 0;
+    st->share_valid = 0;
+    st->elapsed_valid = 0;
+    st->stat_epoch++;
+    return 1;
+}
+
+int baikal_diag_observe_stats(struct baikal_diag_activity *st,
+                              const struct baikal_diag_stat_sample *sample)
+{
+    int reset = 0;
+    const struct baikal_diag_stat_sample *prev;
+
+    if (!st || !sample)
+        return -1;
+    if (!st->stat_ready) {
+        st->stat_ready = 1;
+        st->stat_sample = *sample;
+        return 0;
+    }
+    prev = &st->stat_sample;
+    if (sample->accepted < prev->accepted ||
+            sample->rejected < prev->rejected ||
+            sample->hw < prev->hw ||
+            sample->local_nonce < prev->local_nonce ||
+            sample->local_error < prev->local_error ||
+            sample->diff_accepted + 0.001 < prev->diff_accepted ||
+            sample->diff_rejected + 0.001 < prev->diff_rejected ||
+            sample->device_start_sec != prev->device_start_sec)
+        reset = 1;
+    st->stat_sample = *sample;
+    if (!reset)
+        return 0;
+    st->stat_epoch++;
+    return 1;
+}
+
+int baikal_diag_copy_share(struct baikal_diag_share_view *dst,
+                           baikal_diag_share_load_fn load, void *user,
+                           void (*lock_hash)(void), void (*unlock_hash)(void),
+                           void (*lock_stats)(void), void (*unlock_stats)(void))
+{
+    struct baikal_diag_share_raw raw;
+
+    if (!dst)
+        return -1;
+    memset(dst, 0, sizeof(*dst));
+    if (!load || !lock_hash || !unlock_hash || !lock_stats || !unlock_stats)
+        return 0;
+
+    lock_hash();
+    lock_stats();
+    memset(&raw, 0, sizeof(raw));
+    load(&raw, user);
+    dst->accepted = raw.accepted < 0 ? 0 : (uint64_t)raw.accepted;
+    dst->rejected = raw.rejected < 0 ? 0 : (uint64_t)raw.rejected;
+    dst->hw = raw.hw < 0 ? 0 : (uint64_t)raw.hw;
+    dst->diff_accepted = raw.diff_accepted;
+    dst->diff_rejected = raw.diff_rejected;
+    dst->start_sec = raw.start_sec;
+    dst->start_usec = raw.start_usec;
+    dst->valid = 1;
+    unlock_stats();
+    unlock_hash();
+    return 0;
+}
+
+double baikal_diag_device_elapsed(int64_t start_sec, long start_usec,
+                                  int64_t now_sec, long now_usec, int *valid)
+{
+    double sec;
+
+    if (valid)
+        *valid = 0;
+    if (start_sec == 0)
+        return 0;
+    sec = (double)(now_sec - start_sec) +
+          ((double)now_usec - (double)start_usec) / 1000000.0;
+    if (sec < 1.0)
+        sec = 1.0;
+    if (valid)
+        *valid = 1;
+    return sec;
+}
+
+int baikal_diag_format_grid(const uint32_t grid[BAIKAL_DIAG_UNITS][BAIKAL_DIAG_CHIPS],
+                            char *dst, size_t dst_len)
+{
+    size_t used = 0;
+    int unit;
+    int chip;
+
+    if (!grid || !dst || dst_len == 0)
+        return -1;
+    dst[0] = '\0';
+    for (unit = 0; unit < BAIKAL_DIAG_UNITS; unit++) {
+        for (chip = 0; chip < BAIKAL_DIAG_CHIPS; chip++) {
+            int wrote;
+            int remain;
+
+            if (used >= dst_len)
+                return -1;
+            remain = (int)(dst_len - used);
+            wrote = snprintf(dst + used, (size_t)remain, "%s%u",
+                             (unit == 0 && chip == 0) ? "" : ",",
+                             grid[unit][chip]);
+            if (wrote < 0 || wrote >= remain)
+                return -1;
+            used += (size_t)wrote;
+        }
+    }
+    return 0;
+}
+
+uint64_t baikal_diag_mono_us(void)
+{
+    struct timespec ts;
+
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+        return 0;
+    return (uint64_t)ts.tv_sec * 1000000ull + (uint64_t)ts.tv_nsec / 1000ull;
+}
+
+static void trace_store_enabled(struct baikal_diag_trace *trace, int enabled)
+{
+    __atomic_store_n(&trace->enabled, enabled ? 1 : 0, __ATOMIC_RELEASE);
+}
+
+static int trace_load_enabled(const struct baikal_diag_trace *trace)
+{
+    return __atomic_load_n(&trace->enabled, __ATOMIC_ACQUIRE) ? 1 : 0;
+}
+
+int baikal_diag_trace_enabled(const struct baikal_diag_trace *trace)
+{
+    if (!trace || !trace->ready)
+        return 0;
+    return trace_load_enabled(trace);
+}
+
+static void trace_reset_slots(struct baikal_diag_trace *trace)
+{
+    trace->head = 0;
+    trace->live = 0;
+}
+
+int baikal_diag_trace_init(struct baikal_diag_trace *trace)
+{
+    if (!trace)
+        return -1;
+    memset(trace, 0, sizeof(*trace));
+    if (pthread_mutex_init(&trace->lock, NULL) != 0)
+        return -1;
+    trace->ready = 1;
+    return 0;
+}
+
+void baikal_diag_trace_free(struct baikal_diag_trace *trace)
+{
+    if (!trace || !trace->ready)
+        return;
+    pthread_mutex_lock(&trace->lock);
+    free(trace->buf);
+    trace->buf = NULL;
+    trace->slots = 0;
+    trace->capacity = 0;
+    trace_store_enabled(trace, 0);
+    trace_reset_slots(trace);
+    pthread_mutex_unlock(&trace->lock);
+    pthread_mutex_destroy(&trace->lock);
+    trace->ready = 0;
+}
+
+int baikal_diag_trace_open(struct baikal_diag_trace *trace, uint32_t byte_budget,
+                           int enabled)
+{
+    uint32_t slots;
+    uint8_t *buf;
+
+    if (!trace || !trace->ready)
+        return -1;
+    if (byte_budget == 0)
+        byte_budget = BAIKAL_DIAG_TRACE_BYTES;
+    if (byte_budget > BAIKAL_DIAG_TRACE_BYTES)
+        byte_budget = BAIKAL_DIAG_TRACE_BYTES;
+    slots = byte_budget / BAIKAL_DIAG_TRACE_SLOT;
+    if (slots < 1)
+        return -1;
+
+    buf = (uint8_t *)calloc(slots, BAIKAL_DIAG_TRACE_SLOT);
+    if (!buf)
+        return -1;
+
+    pthread_mutex_lock(&trace->lock);
+    free(trace->buf);
+    trace->buf = buf;
+    trace->slots = slots;
+    trace->capacity = slots * BAIKAL_DIAG_TRACE_SLOT;
+    trace_reset_slots(trace);
+    trace->overwritten = 0;
+    trace->dropped = 0;
+    trace->recorded = 0;
+    trace_store_enabled(trace, enabled);
+    pthread_mutex_unlock(&trace->lock);
+    return 0;
+}
+
+int baikal_diag_trace_set(struct baikal_diag_trace *trace, int enabled)
+{
+    if (!trace || !trace->ready)
+        return -1;
+    if (enabled && !trace->buf) {
+        if (baikal_diag_trace_open(trace, BAIKAL_DIAG_TRACE_BYTES, 1) != 0) {
+            pthread_mutex_lock(&trace->lock);
+            trace_store_enabled(trace, 0);
+            trace->dropped++;
+            pthread_mutex_unlock(&trace->lock);
+            return -1;
+        }
+        return 0;
+    }
+    pthread_mutex_lock(&trace->lock);
+    trace_store_enabled(trace, enabled);
+    pthread_mutex_unlock(&trace->lock);
+    return 0;
+}
+
+void baikal_diag_trace_clear(struct baikal_diag_trace *trace)
+{
+    if (!trace || !trace->ready)
+        return;
+    pthread_mutex_lock(&trace->lock);
+    trace_reset_slots(trace);
+    trace->overwritten = 0;
+    trace->dropped = 0;
+    trace->recorded = 0;
+    if (trace->buf && trace->capacity)
+        memset(trace->buf, 0, trace->capacity);
+    pthread_mutex_unlock(&trace->lock);
+}
+
+static uint32_t trace_record_size(const struct baikal_diag_trace_rec *rec)
+{
+    return (uint32_t)BAIKAL_DIAG_TRACE_HDR + rec->tx_len + rec->rx_len;
+}
+
+static void trace_write_slot(uint8_t *slot, const struct baikal_diag_trace_rec *rec)
+{
+    uint32_t rec_bytes = trace_record_size(rec);
+
+    memset(slot, 0, BAIKAL_DIAG_TRACE_SLOT);
+    wr_u32(slot + 0, rec_bytes);
+    wr_u64(slot + 4, rec->mono_us);
+    wr_u32(slot + 12, rec->generation);
+    wr_u16(slot + 16, rec->tx_len);
+    wr_u16(slot + 18, rec->rx_len);
+    wr_i32(slot + 20, rec->tx_status);
+    wr_i32(slot + 24, rec->rx_status);
+    wr_i16(slot + 28, rec->attempted_clock_code);
+    wr_i16(slot + 30, rec->acked_clock_code);
+    slot[32] = rec->board;
+    slot[33] = rec->cmd;
+    slot[34] = rec->work_idx;
+    slot[35] = rec->flags;
+    slot[36] = rec->ack_miner;
+    slot[37] = rec->ack_cmd;
+    slot[38] = rec->ack_param;
+    slot[39] = rec->ack_dest;
+    wr_u16(slot + 40, rec->tx_transferred);
+    wr_u16(slot + 42, rec->rx_transferred);
+    wr_u16(slot + 44, rec->tx_intended);
+    wr_u16(slot + 46, rec->rx_intended);
+    if (rec->tx_len && rec->tx)
+        memcpy(slot + BAIKAL_DIAG_TRACE_HDR, rec->tx, rec->tx_len);
+    if (rec->rx_len && rec->rx)
+        memcpy(slot + BAIKAL_DIAG_TRACE_HDR + rec->tx_len, rec->rx, rec->rx_len);
+}
+
+int baikal_diag_trace_append(struct baikal_diag_trace *trace,
+                             const struct baikal_diag_trace_rec *rec)
+{
+    uint8_t *slot;
+
+    if (!trace || !trace->ready || !rec)
+        return -1;
+    if (rec->tx_len > BAIKAL_DIAG_TX_MAX || rec->rx_len > BAIKAL_DIAG_RX_MAX ||
+            (rec->tx_len && !rec->tx) || (rec->rx_len && !rec->rx)) {
+        pthread_mutex_lock(&trace->lock);
+        if (trace_load_enabled(trace))
+            trace->dropped++;
+        pthread_mutex_unlock(&trace->lock);
+        return -1;
+    }
+
+    pthread_mutex_lock(&trace->lock);
+    if (!trace_load_enabled(trace) || !trace->buf || trace->slots == 0) {
+        pthread_mutex_unlock(&trace->lock);
+        return 0;
+    }
+    if (trace->live == trace->slots) {
+        trace->overwritten++;
+        trace->live--;
+    }
+    slot = trace->buf + ((size_t)trace->head * BAIKAL_DIAG_TRACE_SLOT);
+    trace_write_slot(slot, rec);
+    trace->head++;
+    if (trace->head >= trace->slots)
+        trace->head = 0;
+    trace->live++;
+    trace->recorded++;
+    pthread_mutex_unlock(&trace->lock);
+    return 0;
+}
+
+int baikal_diag_trace_walk(const uint8_t *buf, uint32_t len,
+                           int (*cb)(const struct baikal_diag_trace_view *view, void *user),
+                           void *user)
+{
+    uint32_t off = 0;
+
+    if (!buf && len)
+        return -1;
+    while (off < len) {
+        struct baikal_diag_trace_view view;
+        uint32_t rec_bytes;
+        uint16_t tx_len;
+        uint16_t rx_len;
+
+        if (len - off < BAIKAL_DIAG_TRACE_HDR)
+            return -1;
+        rec_bytes = rd_u32(buf + off);
+        tx_len = (uint16_t)rd_u16(buf + off + 16);
+        rx_len = (uint16_t)rd_u16(buf + off + 18);
+        if (rec_bytes < BAIKAL_DIAG_TRACE_HDR ||
+                rec_bytes != (uint32_t)BAIKAL_DIAG_TRACE_HDR + tx_len + rx_len ||
+                tx_len > BAIKAL_DIAG_TX_MAX || rx_len > BAIKAL_DIAG_RX_MAX ||
+                rec_bytes > len - off)
+            return -1;
+
+        memset(&view, 0, sizeof(view));
+        view.rec_bytes = rec_bytes;
+        view.mono_us = rd_u64(buf + off + 4);
+        view.generation = rd_u32(buf + off + 12);
+        view.tx_len = tx_len;
+        view.rx_len = rx_len;
+        view.tx_status = rd_i32(buf + off + 20);
+        view.rx_status = rd_i32(buf + off + 24);
+        view.attempted_clock_code = rd_i16(buf + off + 28);
+        view.acked_clock_code = rd_i16(buf + off + 30);
+        view.board = buf[off + 32];
+        view.cmd = buf[off + 33];
+        view.work_idx = buf[off + 34];
+        view.flags = buf[off + 35];
+        view.ack_miner = buf[off + 36];
+        view.ack_cmd = buf[off + 37];
+        view.ack_param = buf[off + 38];
+        view.ack_dest = buf[off + 39];
+        view.tx_transferred = (uint16_t)rd_u16(buf + off + 40);
+        view.rx_transferred = (uint16_t)rd_u16(buf + off + 42);
+        view.tx_intended = (uint16_t)rd_u16(buf + off + 44);
+        view.rx_intended = (uint16_t)rd_u16(buf + off + 46);
+        view.tx = tx_len ? buf + off + BAIKAL_DIAG_TRACE_HDR : NULL;
+        view.rx = rx_len ? buf + off + BAIKAL_DIAG_TRACE_HDR + tx_len : NULL;
+        if (cb && cb(&view, user))
+            return 1;
+        off += rec_bytes;
+    }
+    return 0;
+}
+
+static uint32_t trace_oldest_index(const struct baikal_diag_trace *trace)
+{
+    if (!trace || trace->live == 0)
+        return 0;
+    if (trace->live <= trace->head)
+        return trace->head - trace->live;
+    if (trace->slots == 0)
+        return 0;
+    return trace->slots - (trace->live - trace->head);
+}
+
+int baikal_diag_trace_copy(struct baikal_diag_trace *trace, uint8_t **out,
+                           uint32_t *out_len, uint32_t *live,
+                           uint64_t *overwritten, uint64_t *dropped,
+                           uint64_t *recorded, uint32_t *capacity, int *enabled)
+{
+    uint8_t *copy = NULL;
+    uint32_t bytes = 0;
+    uint32_t count;
+    uint32_t start;
+    uint32_t i;
+
+    if (!trace || !trace->ready || !out || !out_len)
+        return -1;
+
+    pthread_mutex_lock(&trace->lock);
+    count = trace->live;
+    if (live)
+        *live = count;
+    if (overwritten)
+        *overwritten = trace->overwritten;
+    if (dropped)
+        *dropped = trace->dropped;
+    if (recorded)
+        *recorded = trace->recorded;
+    if (capacity)
+        *capacity = trace->capacity;
+    if (enabled)
+        *enabled = trace_load_enabled(trace);
+    if (count && trace->buf) {
+        uint32_t need = 0;
+
+        start = trace_oldest_index(trace);
+        for (i = 0; i < count; i++) {
+            uint32_t idx = start + i;
+
+            if (trace->slots)
+                idx %= trace->slots;
+            need += rd_u32(trace->buf + ((size_t)idx * BAIKAL_DIAG_TRACE_SLOT));
+        }
+        copy = (uint8_t *)malloc(need ? need : 1);
+        if (!copy) {
+            pthread_mutex_unlock(&trace->lock);
+            return -1;
+        }
+        for (i = 0; i < count; i++) {
+            uint32_t idx = start + i;
+            uint8_t *slot;
+            uint32_t rec_bytes;
+
+            if (trace->slots)
+                idx %= trace->slots;
+            slot = trace->buf + ((size_t)idx * BAIKAL_DIAG_TRACE_SLOT);
+            rec_bytes = rd_u32(slot);
+            if (rec_bytes < BAIKAL_DIAG_TRACE_HDR ||
+                    rec_bytes > BAIKAL_DIAG_TRACE_SLOT ||
+                    bytes + rec_bytes > need) {
+                free(copy);
+                pthread_mutex_unlock(&trace->lock);
+                return -1;
+            }
+            memcpy(copy + bytes, slot, rec_bytes);
+            bytes += rec_bytes;
+        }
+    }
+    pthread_mutex_unlock(&trace->lock);
+    *out = copy;
+    *out_len = bytes;
+    return 0;
+}
+
+int baikal_diag_trace_meta(struct baikal_diag_trace *trace,
+                           struct baikal_diag_trace_meta *meta)
+{
+    uint32_t i;
+    uint32_t used = 0;
+    uint32_t start;
+
+    if (!trace || !trace->ready || !meta)
+        return -1;
+
+    memset(meta, 0, sizeof(*meta));
+    pthread_mutex_lock(&trace->lock);
+    meta->enabled = trace_load_enabled(trace);
+    meta->live = trace->live;
+    meta->capacity = trace->capacity;
+    meta->overwritten = trace->overwritten;
+    meta->dropped = trace->dropped;
+    meta->recorded = trace->recorded;
+    start = trace_oldest_index(trace);
+    for (i = 0; i < trace->live && trace->buf; i++) {
+        uint32_t idx = start + i;
+        uint32_t rec_bytes;
+
+        if (trace->slots)
+            idx %= trace->slots;
+        rec_bytes = rd_u32(trace->buf + ((size_t)idx * BAIKAL_DIAG_TRACE_SLOT));
+        if (rec_bytes < BAIKAL_DIAG_TRACE_HDR ||
+                rec_bytes > BAIKAL_DIAG_TRACE_SLOT ||
+                used > BAIKAL_DIAG_TRACE_BYTES - rec_bytes) {
+            pthread_mutex_unlock(&trace->lock);
+            return -1;
+        }
+        used += rec_bytes;
+    }
+    meta->used = used;
+    pthread_mutex_unlock(&trace->lock);
+    return 0;
+}
+
+int baikal_diag_trace_meta_line(char *dst, size_t dst_len,
+                                const struct baikal_diag_trace_meta *meta,
+                                int pid, long start_unix)
+{
+    int n;
+
+    if (!dst || dst_len == 0 || !meta)
+        return -1;
+    n = snprintf(dst, dst_len,
+                 "{\"enabled\":%d,\"live\":%u,\"bytes\":%u,\"capacity\":%u,"
+                 "\"overwritten\":%llu,\"dropped\":%llu,\"recorded\":%llu,"
+                 "\"pid\":%d,\"start_unix\":%ld,"
+                 "\"status\":\"neg_fail_or_nbytes\"}\n",
+                 meta->enabled ? 1 : 0, meta->live, meta->used, meta->capacity,
+                 (unsigned long long)meta->overwritten,
+                 (unsigned long long)meta->dropped,
+                 (unsigned long long)meta->recorded,
+                 pid, start_unix);
+    if (n < 0 || (size_t)n >= dst_len)
+        return -1;
+    return n;
+}
