+static void test_trace_meta(void)
+{
+    struct baikal_diag_trace trace;
+    struct baikal_diag_trace_rec rec;
+    struct baikal_diag_trace_meta meta;
+    char line[256];
+    int n;
+    uint32_t one;
+
+    memset(&rec, 0, sizeof(rec));
+    rec.tx = (const uint8_t *)"ABCD";
+    rec.tx_len = 4;
+    rec.rx = (const uint8_t *)"xyz";
+    rec.rx_len = 3;
+    rec.tx_status = 11;
+    rec.rx_status = 7;
+    rec.mono_us = 5;
+    one = BAIKAL_DIAG_TRACE_HDR + 4 + 3;
+
+    expect(baikal_diag_trace_init(&trace) == 0, "meta trace init");
+    expect(baikal_diag_trace_meta(&trace, &meta) == 0, "meta before open");
+    expect(meta.enabled == 0 && meta.live == 0 && meta.used == 0 &&
+           meta.capacity == 0 && meta.recorded == 0, "off trace has no bytes");
+    expect(baikal_diag_trace_open(&trace, 2 * BAIKAL_DIAG_TRACE_SLOT, 1) == 0,
+           "open two slots");
+    expect(baikal_diag_trace_append(&trace, &rec) == 0, "append one record");
+    expect(baikal_diag_trace_meta(&trace, &meta) == 0, "meta after append");
+    expect(meta.enabled == 1 && meta.live == 1 && meta.used == one &&
+           meta.recorded == 1 && meta.dropped == 0, "used bytes are the record");
+
+    rec.tx_len = BAIKAL_DIAG_TX_MAX + 1;
+    expect(baikal_diag_trace_append(&trace, &rec) != 0, "oversize is not stored");
+    rec.tx_len = 4;
+    expect(baikal_diag_trace_meta(&trace, &meta) == 0 && meta.used == one &&
+           meta.dropped == 1 && meta.live == 1, "drop does not add used bytes");
+
+    expect(baikal_diag_trace_set(&trace, 0) == 0, "meta disable");
+    rec.mono_us = 9;
+    expect(baikal_diag_trace_append(&trace, &rec) == 0, "append while disabled");
+    expect(baikal_diag_trace_meta(&trace, &meta) == 0 && meta.enabled == 0 &&
+           meta.live == 1 && meta.used == one && meta.recorded == 1,
+           "disable keeps the record and ignores new appends");
+    baikal_diag_trace_free(&trace);
+
+    memset(&meta, 0, sizeof(meta));
+    meta.enabled = 1;
+    meta.live = 2;
+    meta.used = one;
+    meta.capacity = 2040;
+    meta.overwritten = 3;
+    meta.dropped = 4;
+    meta.recorded = 9;
+    n = baikal_diag_trace_meta_line(line, sizeof(line), &meta, 42, 1700000000L);
+    expect(n > 0, "metadata line fits");
+    expect(strcmp(line,
+                  "{\"enabled\":1,\"live\":2,\"bytes\":55,\"capacity\":2040,"
+                  "\"overwritten\":3,\"dropped\":4,\"recorded\":9,"
+                  "\"pid\":42,\"start_unix\":1700000000,"
+                  "\"status\":\"neg_fail_or_nbytes\"}\n") == 0,
+           "metadata line contract");
+    expect(strstr(line, "secret") == NULL && strstr(line, "rpc") == NULL &&
+           strstr(line, "password") == NULL && strstr(line, "pool") == NULL,
+           "metadata line has no pool material");
+    expect(one == 55, "record size used by the fixture");
+}
