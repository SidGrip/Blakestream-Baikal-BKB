+    baikal_diag_note_duration(&counters.ack_latency_us_sum, &counters.ack_latency_us_max,
+                              &counters.ack_latency_count, 10);
+    expect(counters.ack_latency_count == 2 && counters.ack_latency_us_sum == 50 &&
+           counters.ack_latency_us_max == 40, "duration sum and max");
