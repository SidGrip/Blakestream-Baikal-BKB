+struct walk_state {
+    int count;
+    int saw_bytes;
+    int saw_fail;
+    int order_ok;
+    uint64_t last_mono;
+};
+
+static int on_view(const struct baikal_diag_trace_view *view, void *user)
+{
+    struct walk_state *st = user;
+
+    if (view->mono_us < st->last_mono)
+        st->order_ok = 0;
+    st->last_mono = view->mono_us;
+    st->count++;
+    if (view->tx_len == 4 && view->tx && memcmp(view->tx, "ABCD", 4) == 0 &&
+            view->rx_len == 3 && view->rx && memcmp(view->rx, "xyz", 3) == 0 &&
+            view->board == 2 && view->cmd == 0x03 && view->work_idx == 0xff &&
+            view->generation == 9 && view->attempted_clock_code == 30 &&
+            view->acked_clock_code == 22 && view->ack_param == 0 &&
+            view->ack_dest == 0 && view->tx_status == 11 && view->rx_status == 7)
+        st->saw_bytes = 1;
+    if ((view->flags & BAIKAL_DIAG_F_FAIL) && (view->flags & BAIKAL_DIAG_F_TX_ONLY) &&
+            view->rx_len == 0 && view->tx_status == -7)
+        st->saw_fail = 1;
+    return 0;
+}
