+static void test_trace(void)
+{
+    struct baikal_diag_trace trace;
+    struct baikal_diag_trace_rec rec;
+    uint8_t *copy = NULL;
+    uint32_t copy_len = 0;
+    uint32_t live = 0;
+    uint32_t capacity = 0;
+    uint64_t overwritten = 0;
+    uint64_t dropped = 0;
+    uint64_t recorded = 0;
+    int enabled = 1;
+    struct walk_state st;
+    int i;
+    uint32_t budget;
+
+    memset(&rec, 0, sizeof(rec));
+    rec.tx = (const uint8_t *)"ABCD";
+    rec.tx_len = 4;
+    rec.rx = (const uint8_t *)"xyz";
+    rec.rx_len = 3;
+    rec.board = 2;
+    rec.cmd = 0x03;
+    rec.work_idx = 0xff;
+    rec.generation = 9;
+    rec.attempted_clock_code = 30;
+    rec.acked_clock_code = 22;
+    rec.ack_param = 0;
+    rec.ack_dest = 0;
+    rec.tx_status = 11;
+    rec.rx_status = 7;
+    rec.mono_us = 100;
+
+    expect(baikal_diag_trace_init(&trace) == 0, "trace init");
+    expect(baikal_diag_trace_append(&trace, &rec) == 0, "append while off");
+    expect(baikal_diag_trace_copy(&trace, &copy, &copy_len, &live, &overwritten,
+                                  &dropped, &recorded, &capacity, &enabled) == 0,
+           "copy while off");
+    expect(copy == NULL && copy_len == 0 && live == 0 && recorded == 0 && enabled == 0,
+           "disabled trace stores nothing");
+    free(copy);
+    copy = NULL;
+
+    budget = 3 * BAIKAL_DIAG_TRACE_SLOT;
+    expect(baikal_diag_trace_open(&trace, budget, 1) == 0, "open small ring");
+    expect(trace.capacity <= BAIKAL_DIAG_TRACE_BYTES, "cap stays inside 2MiB");
+    expect(baikal_diag_trace_set(&trace, 1) == 0, "enable keeps small ring");
+    expect(trace.capacity == budget, "enable does not grow a configured ring");
+
+    rec.tx_len = BAIKAL_DIAG_TX_MAX + 1;
+    expect(baikal_diag_trace_append(&trace, &rec) != 0, "oversize dropped");
+    rec.tx_len = 4;
+    expect(baikal_diag_trace_copy(&trace, &copy, &copy_len, &live, &overwritten,
+                                  &dropped, &recorded, &capacity, &enabled) == 0,
+           "copy after drop");
+    expect(dropped == 1 && live == 0, "drop counted");
+    free(copy);
+    copy = NULL;
+
+    for (i = 0; i < 5; i++) {
+        rec.mono_us = (uint64_t)(1000 + i);
+        rec.flags = 0;
+        rec.rx_len = 3;
+        rec.rx_status = 7;
+        if (i == 3) {
+            rec.flags = BAIKAL_DIAG_F_FAIL | BAIKAL_DIAG_F_TX_ONLY;
+            rec.rx_len = 0;
+            rec.rx = NULL;
+            rec.tx_status = -7;
+            rec.rx_status = 0;
+        } else {
+            rec.tx_status = 11;
+            rec.rx = (const uint8_t *)"xyz";
+        }
+        expect(baikal_diag_trace_append(&trace, &rec) == 0, "append event");
+    }
+    expect(baikal_diag_trace_copy(&trace, &copy, &copy_len, &live, &overwritten,
+                                  &dropped, &recorded, &capacity, &enabled) == 0,
+           "copy ring");
+    expect(live == 3 && overwritten == 2 && recorded == 5 && enabled == 1, "overwrite metadata");
+    expect(capacity <= budget && capacity + BAIKAL_DIAG_TRACE_SLOT > budget,
+           "allocated bytes are the slot budget");
+    memset(&st, 0, sizeof(st));
+    st.order_ok = 1;
+    expect(baikal_diag_trace_walk(copy, copy_len, on_view, &st) == 0, "walk export");
+    expect(st.count == 3 && st.order_ok, "oldest events overwritten in order");
+    expect(st.saw_bytes && st.saw_fail, "payload and failed attempt kept");
+    free(copy);
+
+    expect(baikal_diag_trace_set(&trace, 0) == 0, "disable");
+    rec.mono_us = 9999;
+    rec.flags = 0;
+    rec.rx_len = 3;
+    rec.rx = (const uint8_t *)"xyz";
+    expect(baikal_diag_trace_append(&trace, &rec) == 0, "append after disable");
+    expect(baikal_diag_trace_copy(&trace, &copy, &copy_len, &live, NULL, NULL,
+                                  &recorded, NULL, &enabled) == 0, "copy after disable");
+    expect(enabled == 0 && live == 3 && recorded == 5, "disable stops new events");
+    free(copy);
+    baikal_diag_trace_free(&trace);
+
+    expect(baikal_diag_trace_init(&trace) == 0, "reinit");
+    expect(baikal_diag_trace_open(&trace, BAIKAL_DIAG_TRACE_BYTES, 0) == 0, "full budget");
+    expect(trace.capacity <= BAIKAL_DIAG_TRACE_BYTES, "2MiB bound");
+    expect(trace.capacity >= BAIKAL_DIAG_TRACE_BYTES - BAIKAL_DIAG_TRACE_SLOT,
+           "budget is usable");
+    expect(trace.enabled == 0, "full ring can stay off");
+    baikal_diag_trace_free(&trace);
+}
