+static void test_frame(void)
+{
+    uint8_t data[2] = {0x11, 0x22};
+    uint8_t wire[16];
+    uint8_t expect_wire[11] = {':', 1, 4, 3, 0, 0x00, 0x11, 0x00, 0x22, '\r', '\n'};
+    uint8_t decoded[8];
+    uint8_t miner, cmd, param, dest;
+    int outlen = 0;
+    int dlen = -1;
+    uint8_t payload[210];
+    uint8_t big[512];
+    int i;
+
+    memset(wire, 0x5a, sizeof(wire));
+    expect(baikal_diag_encode_tx(1, 4, 3, 0, data, 2, wire, (int)sizeof(wire), &outlen) == 0,
+           "encode");
+    expect(outlen == 11 && memcmp(wire, expect_wire, 11) == 0, "wire bytes unchanged");
+    expect(baikal_diag_decode_rx(wire, outlen, &miner, &cmd, &param, &dest,
+                                 decoded, (int)sizeof(decoded), &dlen) == outlen,
+           "decode");
+    expect(miner == 1 && cmd == 4 && param == 3 && dest == 0 && dlen == 2 &&
+           decoded[0] == 0x11 && decoded[1] == 0x22, "round trip");
+    expect(baikal_diag_decode_rx(wire, 6, &miner, &cmd, &param, &dest,
+                                 decoded, (int)sizeof(decoded), &dlen) != 0,
+           "short frame rejected");
+
+    for (i = 0; i < 210; i++)
+        payload[i] = (uint8_t)i;
+    expect(baikal_diag_encode_tx(0, 4, 0, 0, payload, 210, big, 512, &outlen) == 0,
+           "send work fits");
+    expect(outlen == 5 + 420 + 2, "send work length");
+    expect(baikal_diag_encode_tx(0, 4, 0, 0, payload, 210, big, outlen - 1, &outlen) != 0,
+           "tight buffer rejected");
+
+    outlen = 77;
+    expect(baikal_diag_encode_tx(0, 4, 0, 0, payload, INT_MAX, big, 512, &outlen) != 0,
+           "encode rejects overflowing length");
+    expect(outlen == 77, "failed encode leaves length untouched");
+    expect(baikal_diag_encode_tx(0, 4, 0, 0, payload, 0, big, 6, &outlen) != 0,
+           "encode rejects a header that does not fit");
+}
