diff --git a/driver-baikalu.c b/driver-baikalu.c
--- a/driver-baikalu.c
+++ b/driver-baikalu.c
@@ -39,7 +39,23 @@
 
 static int baikal_clock_command_code(uint16_t clk)
 {
-    return (clk == 0) ? 0 : ((clk / 10) % 20) + 2;
+    /* Shared monotonic PLL index the v4 firmware reads directly: idx = MHz/10 - 18,
+       clamped to the mode-0x10 ladder [8,32] (~260-500 MHz). clk==0 keeps the
+       firmware default/off path. The old ((clk/10)%20)+2 form was non-monotonic and
+       could not emit indices 22-32, so distinct MHz collapsed onto the same low PLL
+       entries (e.g. 400->code2 and 520->code14 both read ~150 GH/s). On stock
+       firmware the PLL-over-SPI sender is disconnected, so the code is ignored and
+       this change is a no-op until the v4 firmware is flashed. */
+    int idx;
+
+    if (clk == 0)
+        return 0;
+    idx = (int)(clk / 10) - 18;
+    if (idx < 8)
+        idx = 8;
+    if (idx > 32)
+        idx = 32;
+    return idx;
 }
 
 static void baikal_log_raw_clock_experiment_build(void)
