+static int baikal_parse_pll_value(const char **cursor, int *out)
+{
+    const char *p;
+    int value = 0;
+    int digits = 0;
+
+    if (!cursor || !*cursor || !out)
+        return -1;
+    p = *cursor;
+    if (*p < '1' || *p > '9')
+        return -1;
+    while (*p >= '0' && *p <= '9') {
+        digits++;
+        if (digits > 2)
+            return -1;
+        value = value * 10 + (*p - '0');
+        p++;
+    }
+    if (value < 8 || value > 32)
+        return -1;
+    *out = value;
+    *cursor = p;
+    return 0;
+}
+
+char *baikal_parse_board_pll(const char *arg, int index_out[3])
+{
+    const char *p = arg;
+    int i;
+
+    if (!arg || !index_out || *arg == '\0')
+        return "baikal-board-pll must be three integers 8..32 separated by colons";
+    for (i = 0; i < 3; i++) {
+        if (i > 0) {
+            if (*p != ':')
+                return "baikal-board-pll must be three integers 8..32 separated by colons";
+            p++;
+        }
+        if (baikal_parse_pll_value(&p, &index_out[i]) != 0)
+            return "baikal-board-pll values must be integers 8..32 with no sign, decimal, or leading zero";
+    }
+    if (*p != '\0')
+        return "baikal-board-pll must be three integers 8..32 separated by colons";
+    return NULL;
+}
+
+char *baikal_experimental_pll_config_error(void)
+{
+    int parsed[3];
+    int i;
+    bool have;
+
+    if (opt_baikal_board_pll && opt_baikal_board_pll[0] == '\0')
+        return "baikal-board-pll is malformed";
+    have = opt_baikal_board_pll != NULL;
+
+    if (!opt_baikal_experimental_pll && !have)
+        return NULL;
+    if (opt_baikal_experimental_pll && !have)
+        return "baikal-experimental-pll requires baikal-board-pll";
+    if (!opt_baikal_experimental_pll && have)
+        return "baikal-board-pll requires baikal-experimental-pll";
+    if (!opt_baikal_clock_mode || strcmp(opt_baikal_clock_mode, "individual") != 0)
+        return "baikal-experimental-pll requires explicit baikal-clock-mode individual";
+    if (baikal_parse_board_pll(opt_baikal_board_pll, parsed) != NULL)
+        return "baikal-board-pll is malformed";
+    for (i = 0; i < 3; i++) {
+        if (parsed[i] != opt_baikal_board_pll_index[i] ||
+                parsed[i] < 8 || parsed[i] > 32)
+            return "baikal-board-pll does not match the parsed indices";
+    }
+    return NULL;
+}
+
+static int baikal_command_pll_index(const struct baikal_info *info, int miner_id,
+                                    uint16_t clk)
+{
+    int index;
+
+    if (clk == 0)
+        return 0;
+    if (info && info->experimental_pll) {
+        if (info->clock_mode_global || miner_id < 0 || miner_id > 2)
+            return -1;
+        index = info->board_pll[miner_id];
+        if (index < 8 || index > 32)
+            return -1;
+        return index;
+    }
+    return baikal_clock_command_code(clk);
+}
+
+int baikal_requested_pll_index(const struct baikal_info *info, int miner_id)
+{
+    if (!info || !info->experimental_pll || miner_id < 0 || miner_id > 2)
+        return 0;
+    if (info->board_pll[miner_id] < 8 || info->board_pll[miner_id] > 32)
+        return 0;
+    return info->board_pll[miner_id];
+}
