+static void baikal_install_experimental_pll(struct baikal_info *info)
+{
+    int i;
+
+    info->experimental_pll = false;
+    for (i = 0; i < 3; i++)
+        info->board_pll[i] = 0;
+    /* Disabled mode never keeps a previously parsed raw index. Global mode
+     * does not receive per-board indices either. */
+    if (!opt_baikal_experimental_pll || info->clock_mode_global)
+        return;
+    for (i = 0; i < 3; i++) {
+        if (opt_baikal_board_pll_index[i] < 8 || opt_baikal_board_pll_index[i] > 32) {
+            quit(1, "baikal-board-pll index %d is outside 8..32",
+                 opt_baikal_board_pll_index[i]);
+        }
+        info->board_pll[i] = opt_baikal_board_pll_index[i];
+    }
+    info->experimental_pll = true;
+    applog(LOG_NOTICE,
+           "BK-B experimental PLL indices ASC0=%d ASC1=%d ASC2=%d; not calibrated MHz (public clock label %d)",
+           info->board_pll[0], info->board_pll[1], info->board_pll[2], info->clock);
