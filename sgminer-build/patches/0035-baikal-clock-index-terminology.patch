From: Blakestream-GaintB V2.2
Subject: [PATCH] baikal: name the clock-table selector clock index

Rename the clock-table selector without changing the numbers sent on the
wire. Options become baikal-experimental-clock-index and
baikal-board-clock-index. API readback uses RequestedClockIndex and
SentClockIndex. C names for those table indices use clock_index or
clock_indices. MHz fields stay MHz. Wire code 0 stays the fan-only
command and is not a table index. The stock display echo still does not
prove the ASIC PLL locked.

---
--- a/config_parser.c
+++ b/config_parser.c
@@ -680,14 +680,14 @@
 #ifdef USE_BAIKAL
     /* Check before object/array recursion, and do not enter uninitialized
      * miner cleanup when rejecting a startup configuration. */
-    if (empty_string(parentkey) && strcmp(key, "baikal-experimental-pll") == 0 &&
+    if (empty_string(parentkey) && strcmp(key, "baikal-experimental-clock-index") == 0 &&
             !json_is_true(val) && !json_is_false(val)) {
-        fprintf(stderr, "baikal-experimental-pll must be a JSON boolean\n");
+        fprintf(stderr, "baikal-experimental-clock-index must be a JSON boolean\n");
         exit(EXIT_FAILURE);
     }
-    if (empty_string(parentkey) && strcmp(key, "baikal-board-pll") == 0 &&
+    if (empty_string(parentkey) && strcmp(key, "baikal-board-clock-index") == 0 &&
             !json_is_string(val)) {
-        fprintf(stderr, "baikal-board-pll must be a JSON string\n");
+        fprintf(stderr, "baikal-board-clock-index must be a JSON string\n");
         exit(EXIT_FAILURE);
     }
 #endif
@@ -717,18 +717,18 @@
 #ifdef USE_BAIKAL
             /* These two keys must not be skipped when a config file contains
              * a wrong JSON type. Other options keep the historical skip. */
-            if (strcmp(optname, "--baikal-experimental-pll") == 0) {
+            if (strcmp(optname, "--baikal-experimental-clock-index") == 0) {
                 if (json_is_true(val))
-                    opt_baikal_experimental_pll = true;
+                    opt_baikal_experimental_clock_index = true;
                 else if (json_is_false(val))
-                    opt_baikal_experimental_pll = false;
+                    opt_baikal_experimental_clock_index = false;
                 else {
-                    fprintf(stderr, "baikal-experimental-pll must be a JSON boolean\n");
+                    fprintf(stderr, "baikal-experimental-clock-index must be a JSON boolean\n");
                     exit(EXIT_FAILURE);
                 }
-            } else if (strcmp(optname, "--baikal-board-pll") == 0) {
+            } else if (strcmp(optname, "--baikal-board-clock-index") == 0) {
                 if (!json_is_string(val)) {
-                    fprintf(stderr, "baikal-board-pll must be a JSON string\n");
+                    fprintf(stderr, "baikal-board-clock-index must be a JSON string\n");
                     exit(EXIT_FAILURE);
                 }
                 err = opt->cb_arg(json_string_value(val), opt->u.arg);
