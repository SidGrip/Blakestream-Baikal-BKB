+static void baikal_apply_clock_retry(struct cgpu_info *baikal, int miner_id)
+{
+    struct baikal_info *info = baikal->device_data;
+    struct miner_info *miner;
+    time_t now;
+
+    if (!baikal_pin_index_valid(miner_id) || miner_id >= info->miner_count)
+        return;
+
+    miner = &info->miners[miner_id];
+    if (!miner->clock_retry_pending || miner->clock_retry_done || !miner->working)
+        return;
+
+    if (miner->clock_retry_failures >= BAIKAL_CLOCK_RETRY_MAX_FAILURES) {
+        miner->clock_retry_pending = false;
+        applog(LOG_WARNING, "BK-B post-mining clock retry abandoned on ASC %d after %u failures",
+               miner_id, (unsigned int)miner->clock_retry_failures);
+        return;
+    }
+
+    now = time(NULL);
+    if (miner->clock_retry_last_time != 0 &&
+        now - miner->clock_retry_last_time < BAIKAL_CLOCK_RETRY_DELAY_SEC)
+        return;
+
+    miner->clock_retry_last_time = now;
+    applog(LOG_NOTICE,
+           "BK-B post-mining clock retry ASC %d requested=%dMHz sent_code=%d current_echo=%dMHz fan=%u",
+           miner_id, info->clock, miner->sent_clock_code, miner->reported_clock,
+           (unsigned int)info->fanspeed);
+
+    if (baikal_setoption_for_miner(baikal, miner_id, info->clock,
+                                  to_baikal_algorithm(baikal->algorithm.type),
+                                  info->cutofftemp, info->fanspeed) == true) {
+        miner->clock_retry_pending = false;
+        miner->clock_retry_done = true;
+        applog(LOG_NOTICE,
+               "BK-B post-mining clock retry OK ASC %d requested=%dMHz sent_code=%d current_echo=%dMHz",
+               miner_id, info->clock, miner->sent_clock_code, miner->reported_clock);
+        return;
+    }
+
+    miner->clock_retry_failures++;
+    applog(LOG_WARNING,
+           "BK-B post-mining clock retry failed ASC %d requested=%dMHz failure=%u/%u",
+           miner_id, info->clock, (unsigned int)miner->clock_retry_failures,
+           (unsigned int)BAIKAL_CLOCK_RETRY_MAX_FAILURES);
+}
