+static void baikal_queue_fan(struct baikal_info *info, uint8_t fan)
+{
+    mutex_lock(&baikal_fan_lock);
+    info->pending_fanspeed = fan;
+    info->pending_fanspeed_valid = true;
+    info->pending_fanspeed_time = time(NULL);
+    mutex_unlock(&baikal_fan_lock);
+}
+
+static bool baikal_pending_fan_ready(struct baikal_info *info, uint8_t *fan)
+{
+    time_t now = time(NULL);
+    bool ready = false;
+
+    mutex_lock(&baikal_fan_lock);
+    if (info->pending_fanspeed_valid) {
+        if (info->pending_fanspeed == info->fanspeed) {
+            info->pending_fanspeed_valid = false;
+        } else if (info->pending_fanspeed == BAIKAL_FANSPEED_MAX ||
+                   ((info->last_fanspeed_apply_time == 0 ||
+                     now - info->last_fanspeed_apply_time >= BAIKAL_FAN_APPLY_INTERVAL_SEC) &&
+                    (info->last_fanspeed_failure_time == 0 ||
+                     now - info->last_fanspeed_failure_time >= BAIKAL_FAN_FAILURE_BACKOFF_SEC))) {
+            *fan = info->pending_fanspeed;
+            ready = true;
+        }
+    }
+    mutex_unlock(&baikal_fan_lock);
+
+    return ready;
+}
+
+static void baikal_pending_fan_applied(struct baikal_info *info, uint8_t fan)
+{
+    mutex_lock(&baikal_fan_lock);
+    info->fanspeed = fan;
+    info->last_fanspeed_apply_time = time(NULL);
+    info->last_fanspeed_failure_time = 0;
+    if (info->pending_fanspeed_valid && info->pending_fanspeed == fan)
+        info->pending_fanspeed_valid = false;
+    mutex_unlock(&baikal_fan_lock);
+}
+
+static void baikal_pending_fan_failed(struct baikal_info *info)
+{
+    mutex_lock(&baikal_fan_lock);
+    info->last_fanspeed_failure_time = time(NULL);
+    mutex_unlock(&baikal_fan_lock);
+}
+
+static void baikal_apply_pending_fan(struct cgpu_info *baikal)
+{
+    struct baikal_info *info = baikal->device_data;
+    uint8_t fan = 0;
+
+    if (!baikal_pending_fan_ready(info, &fan))
+        return;
+
+    if (baikal_setoption(baikal, info->clock, to_baikal_algorithm(baikal->algorithm.type),
+                         info->cutofftemp, fan) != true) {
+        baikal_pending_fan_failed(info);
+        applog(LOG_WARNING, "BK-B queued fan apply failed at %u%% on ASC %d",
+               (unsigned int)fan, baikal->miner_id);
+        return;
+    }
+
+    baikal_pending_fan_applied(info, fan);
+    applog(LOG_NOTICE, "BK-B queued fan applied at %u%%", (unsigned int)fan);
+}
