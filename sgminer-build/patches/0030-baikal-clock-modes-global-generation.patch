+static bool baikal_clock_miner_active(struct baikal_info *info, int miner_id)
+{
+    struct miner_info *miner;
+    struct thr_info *thr;
+
+    if (!baikal_pin_index_valid(miner_id) || miner_id >= info->miner_count)
+        return false;
+    miner = &info->miners[miner_id];
+    thr = mining_thr[miner->thr_id];
+    if (!thr || !thr->cgpu || thr->cgpu->deven == DEV_DISABLED)
+        return false;
+    if (baikal_routed_miner_has_no_work_target(thr))
+        return false;
+    return miner->working;
+}
+
+static void baikal_apply_global_clock_generation(struct cgpu_info *baikal)
+{
+    struct baikal_info *info = baikal->device_data;
+    bool active[BAIKAL_MAXMINERS] = {false};
+    bool ack[BAIKAL_MAXMINERS] = {false};
+    bool readback[BAIKAL_MAXMINERS] = {false};
+    bool echo_match[BAIKAL_MAXMINERS] = {false};
+    bool pending;
+    bool success = true;
+    uint32_t generation;
+    uint8_t failures;
+    int active_count = 0;
+    int clock_code;
+    int expected_clock;
+    int i;
+    time_t now = time(NULL);
+
+    if (!info->clock_mode_global)
+        return;
+
+    mutex_lock(&info->clock_lock);
+    pending = info->global_clock_pending;
+    generation = info->clock_generation;
+    failures = info->global_clock_failures;
+    if (pending && info->global_clock_inflight)
+        pending = false;
+    if (pending && info->global_clock_last_time != 0 &&
+            now - info->global_clock_last_time < BAIKAL_CLOCK_RETRY_DELAY_SEC)
+        pending = false;
+    mutex_unlock(&info->clock_lock);
+    if (!pending)
+        return;
+
+    for (i = 0; i < info->miner_count; i++) {
+        active[i] = baikal_clock_miner_active(info, i);
+        if (active[i]) {
+            if (!info->miners[i].clock_ready)
+                return;
+            active_count++;
+        }
+    }
+    if (active_count == 0)
+        return;
+
+    clock_code = baikal_clock_command_code((uint16_t)info->clock);
+    expected_clock = baikal_clock_from_command_code(clock_code);
+    mutex_lock(&info->clock_lock);
+    if (!info->global_clock_pending || info->global_clock_inflight ||
+            info->clock_generation != generation) {
+        mutex_unlock(&info->clock_lock);
+        return;
+    }
+    info->global_clock_inflight = true;
+    info->global_clock_last_time = now;
+    mutex_unlock(&info->clock_lock);
+
+    applog(LOG_NOTICE,
+           "BK-B global clock generation %u start requested=%dMHz pll_index=%d active_boards=%d attempt=%u/%u",
+           (unsigned int)generation, info->clock, clock_code, active_count,
+           (unsigned int)(failures + 1),
+           (unsigned int)BAIKAL_GLOBAL_CLOCK_MAX_ATTEMPTS);
+
+    mutex_lock(baikal->mutex);
+    for (i = 0; i < info->miner_count; i++) {
+        if (!active[i])
+            continue;
+        ack[i] = baikal_setoption_for_miner_locked(
+            baikal, i, (uint16_t)info->clock,
+            to_baikal_algorithm(baikal->algorithm.type),
+            info->cutofftemp, info->fanspeed);
+        if (!ack[i])
+            success = false;
+    }
+    for (i = 0; i < info->miner_count; i++) {
+        struct miner_info *miner;
+        if (!active[i])
+            continue;
+        miner = &info->miners[i];
+        readback[i] = baikal_getinfo_for_miner_locked(baikal, i);
+        echo_match[i] = readback[i] && expected_clock > 0 &&
+                        miner->reported_clock == expected_clock;
+        if (!echo_match[i])
+            success = false;
+    }
+    mutex_unlock(baikal->mutex);
+
+    mutex_lock(&info->clock_lock);
+    if (info->clock_generation != generation) {
+        info->global_clock_inflight = false;
+        mutex_unlock(&info->clock_lock);
+        applog(LOG_WARNING,
+               "BK-B global clock generation %u completed stale; newer generation %u is pending",
+               (unsigned int)generation,
+               (unsigned int)info->clock_generation);
+        return;
+    }
+    if (success) {
+        for (i = 0; i < info->miner_count; i++) {
+            struct miner_info *miner;
+            if (!active[i])
+                continue;
+            miner = &info->miners[i];
+            baikal_mark_applied_clock(miner, info->clock);
+            miner->command_verified = true;
+            miner->clock_generation = generation;
+            miner->clock_retry_pending = false;
+            miner->clock_retry_done = true;
+        }
+        info->clock_verified_generation = generation;
+        info->global_clock_pending = false;
+        info->global_clock_failures = 0;
+    } else {
+        info->global_clock_failures++;
+        if (info->global_clock_failures >= BAIKAL_GLOBAL_CLOCK_MAX_ATTEMPTS) {
+            info->global_clock_pending = false;
+            for (i = 0; i < info->miner_count; i++) {
+                if (active[i])
+                    info->miners[i].clock_generation = generation;
+            }
+        }
+    }
+    info->global_clock_inflight = false;
+    failures = info->global_clock_failures;
+    mutex_unlock(&info->clock_lock);
+
+    for (i = 0; i < info->miner_count; i++) {
+        if (!active[i])
+            continue;
+        applog(success ? LOG_NOTICE : LOG_WARNING,
+               "BK-B global generation %u ASC %d requested=%dMHz pll_index=%d host_ack=%s get_info=%s bridge_status_echo=%dMHz expected_echo=%dMHz match=%s command_verified=%s",
+               (unsigned int)generation, i, info->clock, clock_code,
+               ack[i] ? "yes" : "no", readback[i] ? "yes" : "no",
+               info->miners[i].reported_clock, expected_clock,
+               echo_match[i] ? "yes" : "no", success ? "yes" : "no");
+    }
+    applog(success ? LOG_NOTICE : LOG_WARNING,
+           "BK-B global clock generation %u result=%s failures=%u",
+           (unsigned int)generation, success ? "VERIFIED" : "FAILED",
+           (unsigned int)failures);
+}
