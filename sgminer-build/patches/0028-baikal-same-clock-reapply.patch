+static void baikal_queue_clock_reapply(struct miner_info *miner, int clock)
+{
+    mutex_lock(&baikal_clock_reapply_lock);
+    miner->pending_clock_reapply_mhz = clock;
+    miner->pending_clock_reapply_valid = true;
+    miner->clock_reapply_failures = 0;
+    miner->clock_reapply_last_time = 0;
+    mutex_unlock(&baikal_clock_reapply_lock);
+}
+
+static void baikal_apply_pending_clock_reapply(struct cgpu_info *baikal, int miner_id)
+{
+    struct baikal_info *info = baikal->device_data;
+    struct miner_info *miner;
+    bool pending;
+    bool host_ack;
+    bool getinfo_ok = false;
+    bool echo_ok = false;
+    int requested_clock;
+    int clock_code;
+    int expected_clock;
+    time_t now = time(NULL);
+
+    if (!baikal_pin_index_valid(miner_id) || miner_id >= info->miner_count)
+        return;
+
+    miner = &info->miners[miner_id];
+    mutex_lock(&baikal_clock_reapply_lock);
+    pending = miner->pending_clock_reapply_valid;
+    requested_clock = miner->pending_clock_reapply_mhz;
+    if (pending && miner->clock_reapply_last_time != 0 &&
+            now - miner->clock_reapply_last_time < BAIKAL_CLOCK_RETRY_DELAY_SEC)
+        pending = false;
+    if (pending)
+        miner->clock_reapply_last_time = now;
+    mutex_unlock(&baikal_clock_reapply_lock);
+
+    if (!pending || miner->clock_retry_pending || !miner->working)
+        return;
+
+    clock_code = baikal_clock_command_code((uint16_t)requested_clock);
+    host_ack = baikal_setoption_for_miner(
+        baikal, miner_id, (uint16_t)requested_clock,
+        to_baikal_algorithm(baikal->algorithm.type),
+        info->cutofftemp, info->fanspeed);
+    expected_clock = baikal_clock_from_command_code(clock_code);
+    if (host_ack) {
+        getinfo_ok = baikal_getinfo_for_miner(baikal, miner_id);
+        echo_ok = getinfo_ok && expected_clock > 0 &&
+                  miner->reported_clock == expected_clock;
+    }
+
+    mutex_lock(&baikal_clock_reapply_lock);
+    if (host_ack && getinfo_ok && echo_ok) {
+        if (miner->pending_clock_reapply_valid &&
+                miner->pending_clock_reapply_mhz == requested_clock)
+            miner->pending_clock_reapply_valid = false;
+        miner->clock_reapply_failures = 0;
+    } else {
+        miner->clock_reapply_failures++;
+        if (miner->clock_reapply_failures >= BAIKAL_CLOCK_RETRY_MAX_FAILURES)
+            miner->pending_clock_reapply_valid = false;
+    }
+    mutex_unlock(&baikal_clock_reapply_lock);
+
+    applog(host_ack && getinfo_ok && echo_ok ? LOG_NOTICE : LOG_WARNING,
+           "BK-B same-clock reapply ASC %d requested=%dMHz pll_index=%d host_ack=%s get_info=%s bridge_status_echo=%dMHz expected_echo=%dMHz result=%s",
+           miner_id, requested_clock, clock_code,
+           host_ack ? "yes" : "no", getinfo_ok ? "yes" : "no",
+           miner->reported_clock, expected_clock,
+           host_ack && getinfo_ok && echo_ok ? "OK" : "FAILED");
+}
