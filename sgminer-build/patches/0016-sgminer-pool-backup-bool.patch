Use C99 bool literal for pool backup option.

The source uses `bool`/`true` elsewhere. A clean Xenial ARM rebuild failed
because `TRUE` was not defined when `sgminer.c` was recompiled.

--- a/sgminer.c
+++ b/sgminer.c
@@ -863,7 +863,7 @@
 static char* set_pool_backup(const char *arg)
 {
     struct pool *pool = get_current_pool();
-    pool->backup = TRUE;
+    pool->backup = true;
     return (NULL);
 }
