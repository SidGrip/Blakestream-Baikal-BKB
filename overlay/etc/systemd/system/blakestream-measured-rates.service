[Unit]
Description=Flush buffered personal measured rates at clean shutdown
After=local-fs.target
Before=cron.service

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/bin/true
ExecStop=/usr/bin/python /opt/scripta/bin/measured-rate-history.py flush
RemainAfterExit=yes
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
