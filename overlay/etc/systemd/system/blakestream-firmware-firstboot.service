[Unit]
Description=Detect bridge firmware for a fresh Blakestream SD image
Wants=blakestream-system-perms.service rc-local.service
After=local-fs.target blakestream-system-perms.service rc-local.service
Before=cron.service lighttpd.service
ConditionPathExists=/opt/scripta/etc/bkb-firmware-firstboot.pending

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/scripta/bin/firmware-firstboot.py
ExecStopPost=/usr/bin/python3 /opt/scripta/bin/firmware-firstboot.py --recover
TimeoutStartSec=140
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
